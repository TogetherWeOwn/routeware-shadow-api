      ],
      "method": "first",
      "sql": "SELECT COUNT(*) as n FROM container_snapshot c WHERE 1 = 1 AND c.container_id > ?",
    },
    {
      "binds": [
        6,
        2,
      ],
      "method": "all",
      "sql": "SELECT c.container_id, c.pickup_address_id, c.container_type_id, c.serial_number, c.rfid, c.oncall, c.event_code,
              c.gps_locked, c.latitude, c.longitude, c.enabled, c.location_address, c.city, c.state, c.zip, c.container_note,
              c.ud_cost_share_ud, c.ud_enclosure_doors_ud, c.ud_last_compactor_inspection_ud, c.ud_last_enclosure_inspection_ud,
              c.ud_material_stream_ud, c.color, c.service_code_type, c.service_code_input, c.service_code, c.service_date, c.route_ids, c.frequency_ids, c.synced_at
       FROM container_snapshot c WHERE 1 = 1 AND c.container_id > ? ORDER BY c.container_id LIMIT ?",
    },
  ],
}
`;

exports[`'container' snapshot: followable next links > preserves pre-feature JSON bytes and exact executed SQL/binds: filtered-selectors-count-free 1`] = `
{
  "bytes": "{"rows":[{"container_id":2,"enabled":1}],"total":null,"nextCursor":2}",
  "statements": [
    {
      "binds": [
        1,
        2,
        2,
        "synthetic & +/雪? #"<x>",
        "synthetic & +/雪? #"<x>",
        1,
        0,
      ],
      "method": "all",
      "sql": "SELECT c.container_id, c.pickup_address_id, c.container_type_id, c.serial_number, c.rfid, c.oncall, c.event_code,
              c.gps_locked, c.latitude, c.longitude, c.enabled, c.location_address, c.city, c.state, c.zip, c.container_note,
              c.ud_cost_share_ud, c.ud_enclosure_doors_ud, c.ud_last_compactor_inspection_ud, c.ud_last_enclosure_inspection_ud,
              c.ud_material_stream_ud, c.color, c.service_code_type, c.service_code_input, c.service_code, c.service_date, c.route_ids, c.frequency_ids, c.synced_at
       FROM container_snapshot c INNER JOIN address_snapshot a ON a.pickup_address_id = c.pickup_address_id WHERE 1 = 1 AND a.customer_id = ? AND c.pickup_address_id = ? AND c.container_id = ? AND (instr(lower(coalesce(c.location_address, '')), lower(?)) > 0 OR instr(lower(coalesce(c.serial_number, '')), lower(?)) > 0) AND c.enabled = 1 ORDER BY c.container_id LIMIT ? OFFSET ?",
    },
  ],
}
`;

