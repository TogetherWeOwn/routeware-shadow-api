          "routeware",
        ],
      },
    },
    "/api/v1/routeware/reports/query-request-is-complete": {
      "get": {
        "description": "Polls upstream \`GET /Reports/QueryRequestIsComplete\`. Only \`requestID\` (the one-time report request id) and \`_\` (the SPA's cache-buster timestamp) are forwarded upstream; any other query param is silently dropped. Documented in \`docs/PROBLEMS.md\` § query-param allowlist. Routeware signals a failed poll silently as an HTML error page with HTTP 200 — that shape is surfaced as 502 problem+json, never passed through as 200.",
        "parameters": [
          {
            "in": "query",
            "name": "requestID",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "_",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {},
              },
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Upstream Routeware response (JSON, form-encoded, HTML, or other)",
          },
          "502": {
            "description": "Bad Gateway (application/problem+json). Routeware answered with an HTML error page + HTTP 200 instead of a success body.",
          },
        },
        "summary": "QueryRequestIsComplete (allowlisted query params forwarded upstream)",
        "tags": [
          "reports",
        ],
      },
    },
    "/api/v1/shadow/health": {
      "get": {
        "description": "Bearer-gated like every \`/api/v1/*\` route except \`GET /api/v1/health\`. Returns \`{status, service, version}\` when the Worker is running; it does not check D1, R2, or report config.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShadowHealthResponse",
                },
              },
            },
            "description": "Shadow API is running",
          },
          "401": {
            "description": "Unauthorized",
          },
        },
        "summary": "Shadow API liveness probe (versioned, staging slice)",
        "tags": [
          "shadow",
        ],
      },
    },
  },
  "security": [
    {
      "bearerAuth": [],
    },
  ],
  "tags": [
    {
      "name": "meta",
    },
    {
      "description": "Versioned Shadow API staging slice",
