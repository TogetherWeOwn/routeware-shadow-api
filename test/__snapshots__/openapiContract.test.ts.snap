    "/api/v1/data-snapshot/orphans": {
      "get": {
        "description": "Defensive integrity audit of \`address_snapshot.customer_id\` → \`customer_snapshot\` and \`container_snapshot.pickup_address_id\` → \`address_snapshot\`. D1 enforces both foreign keys on writes and parent deletes, so normal streamed syncs cannot create orphans. A nonzero report warrants investigating legacy or out-of-band data and missing or mismatched schema constraints. Returns per-edge orphan counts plus deterministic id samples (ordered by primary key) from one read-only transaction. Same bearer as other snapshot routes.",
        "parameters": [
          {
            "description": "Max ids sampled per edge (counts are unaffected). Out-of-range values are rejected before D1 is touched.",
            "in": "query",
            "name": "sampleLimit",
            "required": false,
            "schema": {
              "default": 100,
              "description": "Max ids sampled per edge (counts are unaffected). Out-of-range values are rejected before D1 is touched.",
              "example": 100,
              "maximum": 500,
              "minimum": 1,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "orphanAddresses": {
                    "count": 0,
                    "sampleIds": [],
                  },
                  "orphanContainers": {
                    "count": 0,
                    "sampleIds": [],
                  },
                },
                "schema": {
                  "$ref": "#/components/schemas/SnapshotOrphanReport",
                },
              },
            },
            "description": "Orphan counts and id samples per FK edge",
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "properties": {
                    "detail": {
                      "type": "string",
                    },
                    "status": {
                      "enum": [
                        400,
                      ],
                      "type": "number",
                    },
                    "title": {
                      "type": "string",
                    },
                    "type": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "detail",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Invalid sampleLimit (application/problem+json). Must be an integer from 1 to 500; invalid values are rejected before any D1 query runs.",
          },
          "401": {
            "description": "Unauthorized",
          },
        },
        "summary": "Report orphan rows on the snapshot FK chain (D1)",
        "tags": [
          "data-snapshot",
        ],
      },
    },
    "/api/v1/data-snapshot/sync": {
      "post": {
        "description": "Runs **customer** → **address** → **container** when the corresponding \`*_REPORT_EXPORT_PATH\` or \`*_REPORT_QUERY_ID\` vars are set. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. This route **chains three internal HTTP calls** to the per-table \`...-snapshot/sync\` routes (via the request origin) so each table runs in a **separate** Worker invocation (D1’s per-invocation operation limit applies per table, not to the whole job). The daily cron uses the same chained path only when \`SHADOW_API_PUBLIC_BASE\` is set (otherwise it falls back to one single-invocation run — see \`src/scheduled.ts\`). Each table is streamed; see \`CUSTOMER_SNAPSHOT.md\`. Pass \`?dryRun=true\` to dry-run every table (the flag is forwarded to each chained subrequest): full parse/validate, would-be counts, no D1 or R2 writes.

**Try it in \`/docs\`:** Authorize with the sync secret once, then Send with an empty body — this is the highest-friction flow made one click. Per-table 200s carry \`{upserted, rowCount}\` only (no \`deleted\` leak); a table with no export source comes back \`null\`, not zeros.",
        "parameters": [
          {
            "description": "Dry run: validate the CSV and return the would-be counts without writing D1 or R2",
            "in": "query",
            "name": "dryRun",
            "required": false,
            "schema": {
              "description": "Dry run: validate the CSV and return the would-be counts without writing D1 or R2",
              "enum": [
                "true",
                "false",
              ],
              "example": "true",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "address": {
                    "rowCount": 2,
                    "upserted": 2,
                  },
                  "container": {
                    "rowCount": 2,
                    "upserted": 2,
                  },
                  "customer": {
                    "rowCount": 2,
                    "upserted": 2,
                  },
                },
                "schema": {
                  "$ref": "#/components/schemas/DataSnapshotSyncResult",
                },
              },
            },
            "description": "Per-table Result (null if that export path is empty or was skipped for FKs)",
          },
          "401": {
            "description": "Unauthorized",
          },
        },
        "summary": "Fetch all configured Routeware CSV reports and upsert D1 (ordered)",
        "tags": [
          "data-snapshot",
        ],
      },
    },
