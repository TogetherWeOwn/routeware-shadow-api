            "schema": {
              "description": "Dry run: run validation only and persist nothing — no upstream write, no D1 write, no R2 write, no cache invalidation. Mutating snapshot POSTs reject any other query key with a value-free 400 before any work.",
              "enum": [
                "true",
                "false",
              ],
              "example": "true",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "deleted": 0,
                  "rowCount": 2,
                  "upserted": 2,
                },
                "schema": {
                  "properties": {
                    "deleted": {
                      "type": "integer",
                    },
                    "rowCount": {
                      "type": "integer",
                    },
                    "skipped": {
                      "type": "boolean",
                    },
                    "upserted": {
                      "type": "integer",
                    },
                  },
                  "required": [
                    "upserted",
                    "rowCount",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Result",
          },
          "401": {
            "description": "Unauthorized",
          },
          "503": {
            "description": "Service Unavailable",
          },
        },
        "summary": "Fetch address report CSV and upsert D1",
        "tags": [
          "address-snapshot",
        ],
      },
    },
