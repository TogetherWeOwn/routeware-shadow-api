      "post": {
        "description": "Proxies to \`Container/SaveContainerForm\` with **application/x-www-form-urlencoded**. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. New container: \`ContainerID=0\` and \`PickupAddressID\`; \`CustomerID\` optional (resolved from D1 address row). Response: \`ok\`, \`routewareStatus\`, \`customerId\`, \`pickupAddressId\`, \`containerId\`, \`upstreamBytes\`, \`localSync\` (ids + fixed \`code\` outcomes only — no submitted fields, no upstream body). Creates (posted id 0/absent, upstream ok) answer 201 with the resolved \`containerId\` — upstream \`data.ContainerID\` first, else the singleton post-refresh D1 id scoped to the owning address; \`null\` remains when no upstream id is available and the diff is empty, ambiguous (0 or 2+ new ids), or unavailable (unknown owner or failed baseline/refresh). Updates echo the posted id with 200. No \`Location\` header: the by-id snapshot URL may not exist locally when the refresh fails, and a header that 404s is worse than none. Dry-run saves echo posted ids while live saves resolve (R21-02 convergence). Pass \`?dryRun=true\` to validate only — same admission and validation, zero upstream/D1/cache writes, \`dryRun: true\` in the response; without a usable session the dry-run fails closed with 503 and never logs in. Only \`dryRun\` is an allowed query key.",
        "parameters": [
          {
            "description": "Dry run: run validation only and persist nothing — no upstream write, no D1 write, no R2 write, no cache invalidation. Mutating snapshot POSTs reject any other query key with a value-free 400 before any work.",
            "in": "query",
            "name": "dryRun",
            "required": false,
            "schema": {
              "description": "Dry run: run validation only and persist nothing — no upstream write, no D1 write, no R2 write, no cache invalidation. Mutating snapshot POSTs reject any other query key with a value-free 400 before any work.",
              "enum": [
                "true",
                "false",
              ],
              "example": "true",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "example": {
                "ContainerID": "0",
                "PickupAddressID": "10",
              },
              "schema": {
                "properties": {
                  "ContainerID": {
                    "type": "string",
                  },
                  "CustomerID": {
                    "type": "string",
                  },
                  "PickupAddressID": {
                    "type": "string",
                  },
                  "__RequestVerificationToken": {
                    "type": "string",
                  },
                },
                "type": "object",
              },
            },
          },
          "description": "SaveContainerForm fields — token injected server-side when omitted (see example)",
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "dryRun": {
                    "summary": "Validation passed only; no upstream write or local refresh (synthetic)",
                    "value": {
                      "containerId": 100,
                      "customerId": 345734,
                      "dryRun": true,
                      "localSync": {
                        "code": "not_attempted",
                        "done": false,
                      },
                      "ok": true,
                      "pickupAddressId": 10,
                      "routewareStatus": null,
                      "upstreamBytes": 0,
                    },
                  },
                  "refreshed": {
                    "summary": "Upstream accepted; local graph refreshed (synthetic)",
                    "value": {
                      "containerId": 100,
                      "customerId": 345734,
                      "localSync": {
                        "addressIds": [
                          10,
                        ],
                        "containerIds": [
                          100,
                        ],
                        "customerId": 345734,
                        "done": true,
                      },
                      "ok": true,
                      "pickupAddressId": 10,
                      "routewareStatus": 200,
                      "upstreamBytes": 16,
                    },
                  },
                  "rejected": {
                    "summary": "Upstream rejected despite HTTP 200; no local refresh (synthetic)",
                    "value": {
                      "containerId": 100,
                      "customerId": 345734,
                      "localSync": {
                        "code": "not_attempted",
                        "done": false,
                      },
                      "ok": false,
                      "pickupAddressId": 10,
                      "routewareStatus": 200,
                      "upstreamBytes": 17,
                    },
                  },
                  "syncFailed": {
                    "summary": "Upstream accepted; local refresh or invalidation failed (synthetic)",
                    "value": {
                      "containerId": 100,
                      "customerId": 345734,
                      "localSync": {
                        "code": "sync_failed",
                        "done": false,
                      },
                      "ok": true,
                      "pickupAddressId": 10,
                      "routewareStatus": 200,
                      "upstreamBytes": 16,
                    },
                  },
                  "unknownCustomer": {
                    "summary": "Upstream accepted; owning customer unresolved (synthetic)",
                    "value": {
                      "containerId": 100,
                      "customerId": null,
                      "localSync": {
                        "code": "unknown_customer_id",
                        "done": false,
                      },
                      "ok": true,
                      "pickupAddressId": 10,
                      "routewareStatus": 200,
                      "upstreamBytes": 16,
                    },
                  },
                },
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ContainerSaveOutcome",
                    },
                    {
                      "$ref": "#/components/schemas/ContainerSaveDryRun",
                    },
                  ],
                },
              },
            },
            "description": "Save or validation-only outcome, not an unconditional success claim. dryRun=true means validation passed with no upstream write, routewareStatus=null, upstreamBytes=0 and localSync.code=not_attempted. On live saves, ok=true with localSync.done=true means upstream acceptance and local refresh; ok=true with done=false means acceptance without completed refresh. ok=false means upstream rejection even on HTTP 200; localSync.code=not_attempted. Never echoes submitted fields or the upstream body. Local refresh is best-effort: HTTP 200 does not guarantee a refreshed local graph. Read ok and localSync separately. Never blindly retry or replay creates after an ambiguous outcome or failed refresh: the upstream write may already have landed. Verify existing IDs and reconcile local state without repeating the create.",
          },
          "201": {
            "content": {
