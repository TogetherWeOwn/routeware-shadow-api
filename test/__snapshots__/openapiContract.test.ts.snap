      },
    },
    "/api/v1/snapshots/{table}/latest": {
      "get": {
        "description": "Streams the newest Routeware CSV archived to R2 for one table, resolved through the \`snapshot-latest/{table}.json\` pointer the sync leg republishes after every archive — no date discovery needed. The referenced history CSV is re-encoded exactly as the explicit-date download re-encodes it: records are split as the importer splits them, blank data records are dropped as its row parsers drop them, and each cell is trimmed and escaped as the export escapes it (a formula-leading cell gets an apostrophe inside quotes; plain numbers are unchanged), and a \`_shadow_csv_encoding\` column with value \`1\` follows the archived columns on every row. Rows end in LF. The stored object is not modified. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. Returns 404 when the pointer or the CSV it names is missing, 500 when the pointer is unreadable. The ETag is a content hash of the served bytes, and \`If-None-Match\` with the current tag returns 304. Operators compare the download with a fresh \`...-snapshot/export\` by business values, not bytes.",
        "parameters": [
          {
            "in": "path",
            "name": "table",
            "required": true,
            "schema": {
              "enum": [
                "customer",
                "address",
                "container",
              ],
              "example": "customer",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "text/csv": {
                "example": "CustomerID,CompanyName,Enabled,_shadow_csv_encoding
345734,ExampleCo,true,1
",
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Latest archive re-encoded for spreadsheets (synthetic customer-report excerpt)",
          },
          "304": {
            "description": "\`If-None-Match\` matched the current content ETag; empty body",
          },
          "400": {
            "description": "Invalid table (application/problem+json). The zod validator rejects anything outside the \`customer|address|container\` enum before any R2 read runs.",
          },
          "401": {
            "description": "Unauthorized",
          },
          "404": {
            "description": "No latest pointer or no referenced archive for that table, including one deleted during the download (application/problem+json)",
          },
          "409": {
            "description": "The archive was replaced between the two reads of one download (application/problem+json). Retry the download.",
          },
          "500": {
            "description": "The latest pointer is unreadable (application/problem+json). Re-run the table sync to republish it.",
          },
          "503": {
            "description": "R2 archive not configured (application/problem+json). The SNAPSHOTS binding is unbound.",
          },
        },
        "summary": "Download the latest archived snapshot CSV from R2",
        "tags": [
          "data-snapshot",
        ],
      },
    },
    "/api/v1/snapshots/{table}/{date}": {
      "get": {
        "description": "Streams the Routeware CSV archived to R2 by a previous snapshot sync (\`snapshots/YYYY-MM-DD/{customer|address|container}.csv\`), re-encoded for spreadsheets: records are split as the importer splits them, blank data records are dropped as its row parsers drop them, and each cell is trimmed and escaped as the export escapes it (a formula-leading cell gets an apostrophe inside quotes; plain numbers are unchanged), and a \`_shadow_csv_encoding\` column with value \`1\` follows the archived columns on every row. Rows end in LF. The stored object is not modified. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. Returns 404 when no archive exists for that table and date. The ETag is a content hash of the served bytes, and \`If-None-Match\` with the current tag returns 304. Operators compare the download with a fresh \`...-snapshot/export\` by business values, not bytes.",
        "parameters": [
          {
            "in": "path",
            "name": "table",
            "required": true,
            "schema": {
              "enum": [
                "customer",
                "address",
                "container",
              ],
              "example": "customer",
              "type": "string",
            },
          },
          {
            "description": "UTC archive date (YYYY-MM-DD)",
            "in": "path",
            "name": "date",
            "required": true,
            "schema": {
              "description": "UTC archive date (YYYY-MM-DD)",
              "example": "2026-01-01",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "text/csv": {
                "example": "CustomerID,CompanyName,Enabled,_shadow_csv_encoding
345734,ExampleCo,true,1
",
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Archive re-encoded for spreadsheets (synthetic customer-report excerpt)",
          },
          "304": {
            "description": "\`If-None-Match\` matched the current content ETag; empty body",
          },
          "400": {
            "description": "Invalid table or date (application/problem+json). The zod validator rejects anything outside the \`customer|address|container\` enum or not shaped \`YYYY-MM-DD\` before any R2 read runs.",
          },
          "401": {
            "description": "Unauthorized",
          },
          "404": {
            "description": "No archive for that table and date, including one deleted during the download (application/problem+json)",
          },
          "409": {
            "description": "The archive was replaced between the two reads of one download (application/problem+json). Retry the download.",
          },
          "503": {
            "description": "R2 archive not configured (application/problem+json). The SNAPSHOTS binding is unbound.",
          },
        },
        "summary": "Download an archived snapshot CSV from R2",
        "tags": [
          "data-snapshot",
        ],
      },
    },
  },
