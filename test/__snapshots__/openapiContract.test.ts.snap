                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Dry-run without a usable Routeware session uses failed-precondition application/problem+json; dry runs never log in. A forwarded live upstream rejection uses the JSON save-outcome envelope with ok=false and localSync.code=not_attempted. Neither is a success claim.",
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerSaveOutcome",
                },
              },
              "application/problem+json": {
