          },
          "400": {
            "description": "Invalid id (application/problem+json)",
          },
          "404": {
            "description": "Not found (application/problem+json)",
          },
        },
        "summary": "Get one address snapshot row",
        "tags": [
          "address-snapshot",
        ],
      },
    },
    "/api/v1/container-snapshot": {
      "get": {
        "description": "Routeware containers link to an address via \`pickup_address_id\` (and thus to a customer). Filter by \`customerId\` (joins through address), \`pickupAddressId\`, or \`containerId\`, text \`q\` on \`location_address\` or \`serial_number\`, and \`enabled\`. Pass \`cursor\` (the previous page's \`nextCursor\`) instead of \`offset\` to page deep result sets by primary-key seek instead of a scanned OFFSET.",
        "parameters": [
          {
            "in": "query",
