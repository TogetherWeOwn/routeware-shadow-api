                      "CustomerID": 345734,
                      "Enabled": true,
                      "PickupAddressID": 10,
                      "State": "TX",
                      "Zip": "76541",
                    },
                  ],
                },
                "schema": {
                  "properties": {
                    "currentCustomer": {
                      "type": "object",
                    },
                    "data": {
                      "items": {
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              },
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                },
