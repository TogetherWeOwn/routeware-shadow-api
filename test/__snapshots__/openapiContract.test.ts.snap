    "/api/v1/routeware/customer/save-long-form": {
      "post": {
        "description": "Proxies to WebRW \`SaveCustomerLongForm\` with **application/x-www-form-urlencoded** bodies. **Anti-forgery:** when \`__RequestVerificationToken\` is missing or is a placeholder, the Worker uses the stored Routeware session to GET \`AddNewLong\` (create, \`CustomerID\` 0 / absent) or \`LoadLongCustomerModal?customerID=\` (edit), parses the token from HTML, and injects it before forwarding—clients normally do not need to send a token. Set \`CUSTOMER_SAVE_AUTO_TOKEN=false\` to disable. Use \`CustomerID=0\` for create; set \`CustomerID\` for updates. Disable customers with \`Enabled=false\` (no upstream delete).",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {},
              },
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Upstream Routeware response (JSON, form-encoded, HTML, or other)",
          },
        },
        "summary": "SaveCustomerLongForm (create or update)",
        "tags": [
          "customer",
        ],
      },
    },
