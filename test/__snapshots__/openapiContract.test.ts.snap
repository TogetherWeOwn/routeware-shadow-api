    "/api/v1/routeware/reports/query-request-is-complete": {
      "get": {
        "description": "Polls upstream \`GET /Reports/QueryRequestIsComplete\`. Only \`requestID\` (the one-time report request id) and \`_\` (the SPA's cache-buster timestamp) are forwarded upstream; any other query param is silently dropped. Documented in \`docs/PROBLEMS.md\` § query-param allowlist. Routeware signals a failed poll silently as an HTML error page with HTTP 200 — that shape is surfaced as 502 problem+json, never passed through as 200.",
        "parameters": [
          {
            "in": "query",
            "name": "requestID",
            "required": false,
            "schema": {
              "example": "00000000-0000-4000-8000-000000000001",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "_",
            "required": false,
            "schema": {
              "example": "1767225600000",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": true,
                "schema": {},
              },
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
              "text/plain": {
                "example": "true",
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Report completion poll (illustrative JSON boolean or plain text)",
          },
          "502": {
            "description": "Bad Gateway (application/problem+json). Routeware answered with an HTML error page + HTTP 200 instead of a success body.",
          },
        },
        "summary": "QueryRequestIsComplete (allowlisted query params forwarded upstream)",
        "tags": [
          "reports",
        ],
      },
    },
    "/api/v1/shadow/health": {
      "get": {
        "description": "Bearer-gated like every \`/api/v1/*\` route except \`GET /api/v1/health\`. Returns \`{status, service, version}\` when the Worker is running; it does not check D1, R2, or report config.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShadowHealthResponse",
                },
              },
            },
            "description": "Shadow API is running",
          },
          "401": {
            "description": "Unauthorized",
          },
        },
        "summary": "Shadow API liveness probe (versioned, staging slice)",
        "tags": [
          "shadow",
        ],
      },
    },
    "/api/v1/snapshots/{table}/{date}": {
      "get": {
        "description": "Streams the Routeware CSV archived to R2 by a previous snapshot sync (\`snapshots/YYYY-MM-DD/{customer|address|container}.csv\`), re-encoded for spreadsheets: records split as the importer splits them, each cell escaped as the export escapes it (a formula-leading cell gets an apostrophe inside quotes; plain numbers are unchanged), and a \`_shadow_csv_encoding\` column with value \`1\` after the archived columns on every row. Rows end in LF. The stored object is not modified. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. Returns 404 when no archive exists for that table and date. The ETag is a content hash of the served bytes, and \`If-None-Match\` with the current tag returns 304. Operators compare the download with a fresh \`...-snapshot/export\` by business values, not bytes.",
        "parameters": [
          {
            "in": "path",
            "name": "table",
            "required": true,
            "schema": {
              "enum": [
                "customer",
                "address",
                "container",
              ],
              "example": "customer",
              "type": "string",
            },
          },
          {
            "description": "UTC archive date (YYYY-MM-DD)",
            "in": "path",
            "name": "date",
            "required": true,
            "schema": {
              "description": "UTC archive date (YYYY-MM-DD)",
              "example": "2026-01-01",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "text/csv": {
                "example": "CustomerID,CompanyName,Enabled,_shadow_csv_encoding
345734,ExampleCo,true,1
",
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Archive re-encoded for spreadsheets (synthetic customer-report excerpt)",
          },
          "304": {
            "description": "\`If-None-Match\` matched the current content ETag; empty body",
          },
          "400": {
            "description": "Invalid table or date (application/problem+json). The zod validator rejects anything outside the \`customer|address|container\` enum or not shaped \`YYYY-MM-DD\` before any R2 read runs.",
          },
          "401": {
            "description": "Unauthorized",
          },
          "404": {
            "description": "No archive for that table and date (application/problem+json)",
          },
          "409": {
            "description": "The archive was replaced between the two reads of one download (application/problem+json). Retry the download.",
          },
          "503": {
            "description": "R2 archive not configured (application/problem+json). The SNAPSHOTS binding is unbound.",
          },
        },
        "summary": "Download an archived snapshot CSV from R2",
        "tags": [
          "data-snapshot",
        ],
      },
    },
  },
  "security": [
    {
      "bearerAuth": [],
    },
  ],
  "tags": [
    {
      "name": "meta",
    },
    {
      "description": "Versioned Shadow API staging slice",
      "name": "shadow",
    },
    {
      "name": "routeware",
    },
    {
      "name": "customer",
    },
    {
      "description": "Routeware PickupAddress writes (explicit proxy to WebRW)",
      "name": "address",
    },
    {
      "description": "Routeware Container writes (explicit proxy to WebRW)",
      "name": "container",
    },
    {
      "name": "data",
    },
    {
      "name": "reports",
    },
    {
      "description": "D1: customer custom report",
      "name": "customer-snapshot",
    },
    {
      "description": "D1: address custom report",
      "name": "address-snapshot",
    },
    {
      "description": "D1: container custom report",
      "name": "container-snapshot",
    },
    {
      "description": "D1: combined report sync",
      "name": "data-snapshot",
    },
    {
      "description": "D1 aggregate reads (customer + address + container) and writes through Routeware with local snapshot sync",
      "name": "data-entity",
    },
  ],
  "webhooks": {},
}
`;
