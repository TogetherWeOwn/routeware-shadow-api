    "/api/v1/routeware/home/index": {
      "get": {
        "description": "Forwards to WebRW \`Home/Index\` under the shared Routeware session (unlike the sessionless \`login-page\` probe). Upstream answers with whatever content type the SPA serves — HTML, JSON, or other.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {},
                "schema": {},
              },
              "text/html": {
                "example": "<!DOCTYPE html><html><body>Routeware home</body></html>",
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Upstream /WebRW/Home/Index (may be HTML, JSON, or other content types; synthetic excerpt)",
          },
          "401": {
            "description": "Unauthorized",
          },
        },
        "summary": "Routeware home index (sessioned passthrough)",
        "tags": [
          "routeware",
        ],
      },
    },
    "/api/v1/routeware/reports/query-request-is-complete": {
      "get": {
        "description": "Polls upstream \`GET /Reports/QueryRequestIsComplete\`. Only \`requestID\` (the one-time report request id) and \`_\` (the SPA's cache-buster timestamp) are forwarded upstream; any other query param is silently dropped. Documented in \`docs/PROBLEMS.md\` § query-param allowlist. Routeware signals a failed poll silently as an HTML error page with HTTP 200 — that shape is surfaced as 502 problem+json, never passed through as 200.",
        "parameters": [
          {
            "in": "query",
            "name": "requestID",
            "required": false,
            "schema": {
              "example": "00000000-0000-4000-8000-000000000001",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "_",
            "required": false,
            "schema": {
              "example": "1767225600000",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": true,
                "schema": {},
              },
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
              "text/plain": {
                "example": "true",
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Report completion poll (illustrative JSON boolean or plain text)",
          },
          "502": {
            "description": "Bad Gateway (application/problem+json). Routeware answered with an HTML error page + HTTP 200 instead of a success body.",
          },
        },
        "summary": "QueryRequestIsComplete (allowlisted query params forwarded upstream)",
        "tags": [
          "reports",
        ],
      },
    },
    "/api/v1/shadow/health": {
      "get": {
        "description": "Bearer-gated like every \`/api/v1/*\` route except \`GET /api/v1/health\`. Returns \`{status, service, version}\` when the Worker is running; it does not check D1, R2, or report config.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShadowHealthResponse",
                },
              },
            },
            "description": "Shadow API is running",
          },
          "401": {
            "description": "Unauthorized",
          },
        },
        "summary": "Shadow API liveness probe (versioned, staging slice)",
        "tags": [
          "shadow",
        ],
      },
    },
    "/api/v1/snapshots/{table}": {
      "get": {
        "description": "Lists the UTC dates holding an R2 archive for one table, newest-first, from the date-manifest sidecars (\`snapshots/YYYY-MM-DD.manifest.json\`). Each entry carries the manifest's recorded byte length and sha256 (hashes/sizes only, never row data). \`limit\` caps the page at 1..366 (default 30); \`truncated\` is true when possibly more dates exist — the page filled, the 366-manifest scan budget exhausted, or the R2 list truncated. Zero archives is 200 with an empty list, never 404. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. The ETag is a content hash of the served JSON bytes, and \`If-None-Match\` with the current tag returns 304.",
        "parameters": [
          {
            "in": "path",
            "name": "table",
            "required": true,
            "schema": {
              "enum": [
                "customer",
                "address",
                "container",
              ],
              "example": "customer",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 30,
              "example": 30,
              "maximum": 366,
              "minimum": 1,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "dates": [
                    {
                      "bytes": 1234,
                      "date": "2026-09-27",
                      "sha256": "9f2c4a7e1b5d83f09f2c4a7e1b5d83f09f2c4a7e1b5d83f09f2c4a7e1b5d83f0",
                    },
                  ],
                  "table": "customer",
                  "truncated": false,
                },
                "schema": {
                  "properties": {
                    "dates": {
                      "items": {
                        "properties": {
                          "bytes": {
                            "type": "number",
                          },
