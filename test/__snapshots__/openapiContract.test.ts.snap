          },
          "304": {
            "description": "Not modified",
          },
          "400": {
            "description": "Missing or invalid id or alias: every supplied ID must be a canonical positive decimal safe integer (application/problem+json). Invalid \`fields\` or \`fields[type]\` selectors — including unknown \`fields[TYPE]\` keys and flat-plus-typed-root pairs — and unknown query keys are value-free 400s before cache or D1 reads. Batch \`ids\` cannot be combined with \`id\`/alias or any field selector.",
