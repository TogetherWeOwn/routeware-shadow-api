    "/api/v1/routeware/customer": {
      "delete": {
        "description": "Routeware WebRW does not expose a hard delete. Disable or retire a customer by submitting \`save-long-form\` with \`Enabled=false\` (and other required fields from the loaded record).",
        "responses": {
          "405": {
            "description": "Method not allowed (application/problem+json). Use save-long-form with Enabled=false to disable.",
          },
        },
        "summary": "Delete customer (not supported upstream)",
        "tags": [
          "customer",
        ],
      },
    },
    "/api/v1/routeware/customer/add-new-long": {
