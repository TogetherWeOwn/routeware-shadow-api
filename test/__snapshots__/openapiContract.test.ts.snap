        "description": "Raw CSV. Bear same secret. Import or sync **addresses** (and **customers**) first for \`pickup_address_id\` foreign keys.",
        "requestBody": {
          "content": {
            "text/csv": {
              "example": "ContainerID,PickupAddressID,ContainerTypeID,SerialNumber,RFID,OnCall,EventCode,GPSLocked,Latitude,Longitude,Enabled,Address,City,State,Zip,ContainerNote
100,10,,SN-100,,false,,false,,,true,1 Main St,Killeen,TX,76541,",
              "schema": {
                "type": "string",
              },
            },
          },
          "description": "Routeware Container Details CSV (header + data rows — see example)",
