      "post": {
        "description": "Proxies to \`SaveCustomerLongForm\` (same as \`/api/v1/routeware/customer/save-long-form\`) with **application/x-www-form-urlencoded**. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. \`CustomerID=0\` or absent for create. On upstream acceptance with a resolved customer ID, attempts to refresh D1 from \`GetCustomerDetailFull\` and invalidate related cache entries; this can fail independently of the write. Response: \`ok\`, \`routewareStatus\`, \`customerId\`, \`upstreamBytes\`, \`localSync\` (ids + fixed \`code\` outcomes only — no submitted fields, no upstream body). Pass \`?dryRun=true\` to validate only — same admission and validation, zero upstream/D1/cache writes, \`dryRun: true\` in the response; without a usable session the dry-run fails closed with 503 and never logs in. Only \`dryRun\` is an allowed query key.",
        "parameters": [
          {
            "description": "Dry run: run validation only and persist nothing — no upstream write, no D1 write, no R2 write, no cache invalidation. Mutating snapshot POSTs reject any other query key with a value-free 400 before any work.",
            "in": "query",
            "name": "dryRun",
            "required": false,
            "schema": {
              "description": "Dry run: run validation only and persist nothing — no upstream write, no D1 write, no R2 write, no cache invalidation. Mutating snapshot POSTs reject any other query key with a value-free 400 before any work.",
              "enum": [
                "true",
                "false",
              ],
              "example": "true",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "example": {
                "CompanyName": "ExampleCo",
                "CustomerID": "0",
                "CustomerTypeID": "1",
                "Enabled": "true",
                "FirstName": "Jane",
                "LastName": "Doe",
              },
              "schema": {
                "properties": {
                  "CompanyName": {
                    "type": "string",
                  },
                  "CustomerID": {
                    "type": "string",
                  },
                  "CustomerTypeID": {
                    "type": "string",
                  },
                  "Enabled": {
                    "type": "string",
                  },
                  "FirstName": {
                    "type": "string",
                  },
                  "LastName": {
                    "type": "string",
                  },
                  "__RequestVerificationToken": {
                    "type": "string",
                  },
                },
                "type": "object",
              },
            },
          },
          "description": "SaveCustomerLongForm fields — token injected server-side when omitted (see example)",
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "dryRun": {
                    "summary": "Validation passed only; no upstream write or local refresh (synthetic)",
                    "value": {
                      "customerId": 345734,
                      "dryRun": true,
                      "localSync": {
                        "code": "not_attempted",
                        "done": false,
                      },
                      "ok": true,
                      "routewareStatus": null,
                      "upstreamBytes": 0,
                    },
                  },
                  "refreshed": {
                    "summary": "Upstream accepted; local graph refreshed (synthetic)",
                    "value": {
                      "customerId": 345734,
                      "localSync": {
                        "addressIds": [
                          10,
                        ],
                        "containerIds": [
                          100,
                        ],
                        "customerId": 345734,
                        "done": true,
                      },
                      "ok": true,
                      "routewareStatus": 200,
                      "upstreamBytes": 36,
                    },
                  },
                  "rejected": {
                    "summary": "Upstream rejected despite HTTP 200; no local refresh (synthetic)",
                    "value": {
                      "customerId": 345734,
                      "localSync": {
                        "code": "not_attempted",
                        "done": false,
                      },
                      "ok": false,
                      "routewareStatus": 200,
                      "upstreamBytes": 17,
                    },
                  },
                  "syncFailed": {
                    "summary": "Upstream accepted; local refresh or invalidation failed (synthetic)",
                    "value": {
                      "customerId": 345734,
                      "localSync": {
                        "code": "sync_failed",
                        "done": false,
                      },
                      "ok": true,
                      "routewareStatus": 200,
                      "upstreamBytes": 36,
                    },
                  },
                  "unknownCustomer": {
                    "summary": "Upstream accepted; owning customer unresolved (synthetic)",
                    "value": {
                      "customerId": null,
                      "localSync": {
                        "code": "unknown_customer_id",
                        "done": false,
                      },
                      "ok": true,
                      "routewareStatus": 200,
                      "upstreamBytes": 36,
                    },
                  },
                },
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CustomerSaveOutcome",
                    },
                    {
                      "$ref": "#/components/schemas/CustomerSaveDryRun",
                    },
                  ],
                },
              },
            },
            "description": "Save or validation-only outcome, not an unconditional success claim. dryRun=true means validation passed with no upstream write, routewareStatus=null, upstreamBytes=0 and localSync.code=not_attempted. On live saves, ok=true with localSync.done=true means upstream acceptance and local refresh; ok=true with done=false means acceptance without completed refresh. ok=false means upstream rejection even on HTTP 200; localSync.code=not_attempted. Never echoes submitted fields or the upstream body. Local refresh is best-effort: HTTP 200 does not guarantee a refreshed local graph. Read ok and localSync separately. Never blindly retry or replay creates after an ambiguous outcome or failed refresh: the upstream write may already have landed. Verify existing IDs and reconcile local state without repeating the create.",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerSaveOutcome",
                },
              },
              "application/problem+json": {
                "schema": {
                  "properties": {
                    "detail": {
                      "type": "string",
                    },
                    "instance": {
                      "type": "string",
                    },
                    "requestId": {
                      "type": "string",
                    },
                    "status": {
                      "type": "integer",
                    },
                    "title": {
                      "type": "string",
                    },
                    "type": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Local validation failure uses application/problem+json; forwarded upstream rejection uses the JSON save-outcome envelope with ok=false and localSync.code=not_attempted. Inspect the media type, not only the status.",
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerSaveOutcome",
                },
              },
              "application/problem+json": {
                "schema": {
                  "properties": {
                    "detail": {
                      "type": "string",
                    },
                    "instance": {
                      "type": "string",
                    },
                    "requestId": {
                      "type": "string",
                    },
                    "status": {
                      "type": "integer",
                    },
                    "title": {
                      "type": "string",
                    },
                    "type": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Local bearer denial uses application/problem+json; forwarded upstream rejection uses the JSON save-outcome envelope with ok=false and localSync.code=not_attempted. An upstream 401 does not mean the caller's bearer is invalid.",
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerSaveOutcome",
                },
              },
              "application/problem+json": {
                "schema": {
                  "properties": {
                    "detail": {
                      "type": "string",
                    },
                    "instance": {
                      "type": "string",
                    },
                    "requestId": {
                      "type": "string",
                    },
                    "status": {
                      "type": "integer",
                    },
                    "title": {
                      "type": "string",
                    },
                    "type": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Bad Gateway: preparation/transport failures use application/problem+json; forwarded upstream rejection uses the JSON save-outcome envelope with ok=false and localSync.code=not_attempted. Neither is a success claim.",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerSaveOutcome",
                },
              },
              "application/problem+json": {
                "schema": {
                  "properties": {
                    "detail": {
                      "type": "string",
                    },
                    "instance": {
