    "/api/v1/data/container": {
      "get": {
        "description": "Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. Read aggregate from the daily snapshot DB. Caching: \`ETag\` / \`If-None-Match\` and the Workers **Cache** API; invalidated after successful POST. Query: \`id\` = \`container_id\` (alias \`containerId\`). Batch: \`ids=1,2,3\` hydrates up to 50 records as \`{entries}\` in request order (\`no-store\`, no ETag); \`ids\` cannot be combined with \`id\`/alias. Optional \`fields=serial_number,location_address\` projects only the \`.container\` root plus \`container_id\` on single-ID reads; related data remains unchanged unless a typed selector below names its type. Optional \`fields[customer]\`, \`fields[address]\`, \`fields[container]\` project every object of that type — the root and all nested relations — from the same per-type allowlists; omitted types stay full, every projected object keeps its primary id, and \`fields\` plus \`fields[container]\` together are a 400. Omitted selectors preserve the full response. ETags hash the served bytes for each representation; projected validators never reuse a full-only validator, and the canonical full cache is never overwritten by a projection. Field selectors apply to single-ID reads; combining \`ids\` with \`fields\` or any \`fields[type]\` is a value-free 400. Unknown query keys are a value-free 400 before any cache or D1 work.",
        "parameters": [
          {
            "description": "Canonical positive decimal safe integer, from 1 to 9007199254740991, without leading zeros, whitespace, signs, fractions, exponents or hex. Every supplied spelling must be valid; id wins over the alias. Hydrated entity reads reject any other query key with a value-free 400 before any work.",
            "in": "query",
            "name": "id",
            "required": false,
            "schema": {
              "description": "Canonical positive decimal safe integer, from 1 to 9007199254740991, without leading zeros, whitespace, signs, fractions, exponents or hex. Every supplied spelling must be valid; id wins over the alias. Hydrated entity reads reject any other query key with a value-free 400 before any work.",
              "example": 100,
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "description": "Canonical positive decimal safe integer, from 1 to 9007199254740991, without leading zeros, whitespace, signs, fractions, exponents or hex. Every supplied spelling must be valid; id wins over the alias. Hydrated entity reads reject any other query key with a value-free 400 before any work.",
            "in": "query",
            "name": "containerId",
            "required": false,
            "schema": {
              "description": "Canonical positive decimal safe integer, from 1 to 9007199254740991, without leading zeros, whitespace, signs, fractions, exponents or hex. Every supplied spelling must be valid; id wins over the alias. Hydrated entity reads reject any other query key with a value-free 400 before any work.",
              "example": 100,
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "description": "Batch lookup as one comma-separated \`ids\` value: 1 to 50 canonical positive decimal safe integers (1 to 9007199254740991) without leading zeros, whitespace, signs, fractions, exponents or hex. Every entry is validated before any read; any malformed or empty entry, mixing with \`id\`/alias/\`fields\`/\`fields[type]\`, or more than 50 ids fails the whole request 400 with zero partial reads. Batch 200s return \`{entries}\` in request order with \`no-store\` and no ETag.",
            "in": "query",
            "name": "ids",
            "required": false,
            "schema": {
              "description": "Batch lookup as one comma-separated \`ids\` value: 1 to 50 canonical positive decimal safe integers (1 to 9007199254740991) without leading zeros, whitespace, signs, fractions, exponents or hex. Every entry is validated before any read; any malformed or empty entry, mixing with \`id\`/alias/\`fields\`/\`fields[type]\`, or more than 50 ids fails the whole request 400 with zero partial reads. Batch 200s return \`{entries}\` in request order with \`no-store\` and no ETag.",
              "example": "1,2,3",
              "type": "string",
            },
          },
          {
            "description": "Comma-separated sparse fieldset: exact stored column names from this route's allowlist (case-sensitive, no spaces, no empty segments, no duplicates, single key only). Response rows contain exactly these fields plus the resource id, which is always present even when omitted. Unknown names are a value-free 400 before any D1 work.",
            "in": "query",
            "name": "fields",
            "required": false,
            "schema": {
              "description": "Comma-separated sparse fieldset: exact stored column names from this route's allowlist (case-sensitive, no spaces, no empty segments, no duplicates, single key only). Response rows contain exactly these fields plus the resource id, which is always present even when omitted. Unknown names are a value-free 400 before any D1 work.",
              "example": "serial_number,location_address",
              "type": "string",
