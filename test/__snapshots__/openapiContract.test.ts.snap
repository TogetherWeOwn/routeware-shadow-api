                  "ud_last_compactor_inspection_ud": null,
                  "ud_last_enclosure_inspection_ud": null,
                  "ud_material_stream_ud": null,
                  "zip": "76541",
                },
                "schema": {
                  "additionalProperties": {},
                  "type": "object",
                },
              },
            },
            "description": "Row",
          },
          "400": {
            "description": "Invalid id or fields selector (application/problem+json). An unknown/empty/duplicate \`fields\` name is rejected before any D1 query runs.",
