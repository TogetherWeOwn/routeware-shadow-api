                "null",
              ],
            },
          },
          {
            "description": "Address line substring (case-insensitive)",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "description": "Address line substring (case-insensitive)",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "enabled",
            "required": false,
            "schema": {
              "default": "any",
              "enum": [
                "true",
                "false",
                "any",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
