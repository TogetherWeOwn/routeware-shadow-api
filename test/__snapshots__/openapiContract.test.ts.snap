                    "upserted",
                    "rowCount",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Result",
          },
          "401": {
            "description": "Unauthorized",
          },
          "503": {
            "description": "Service Unavailable",
          },
        },
        "summary": "Fetch container report CSV and upsert D1",
        "tags": [
          "container-snapshot",
        ],
      },
    },
    "/api/v1/container-snapshot/{containerId}": {
      "get": {
        "description": "Reads one row from the daily snapshot DB by \`containerId\`. Bearer-gated like every \`/api/v1/*\` route except \`GET /api/v1/health\`. Returns 404 when no row exists for that id.",
        "parameters": [
          {
            "in": "path",
            "name": "containerId",
            "required": false,
            "schema": {
              "example": 100,
              "type": [
                "integer",
                "null",
              ],
            },
          },
          {
            "description": "Comma-separated sparse fieldset: exact stored column names from this route's allowlist (case-sensitive, no spaces, no empty segments, no duplicates, single key only). Response rows contain exactly these fields plus the resource id, which is always present even when omitted. Unknown names are a value-free 400 before any D1 work.",
            "in": "query",
            "name": "fields",
            "required": false,
            "schema": {
              "description": "Comma-separated sparse fieldset: exact stored column names from this route's allowlist (case-sensitive, no spaces, no empty segments, no duplicates, single key only). Response rows contain exactly these fields plus the resource id, which is always present even when omitted. Unknown names are a value-free 400 before any D1 work.",
              "example": "serial_number,location_address",
