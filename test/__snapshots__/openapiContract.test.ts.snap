    },
    {
      "description": "Routeware Container writes (explicit proxy to WebRW)",
      "name": "container",
    },
    {
      "name": "data",
    },
    {
      "name": "reports",
    },
    {
      "description": "D1: customer custom report",
      "name": "customer-snapshot",
    },
    {
      "description": "D1: address custom report",
      "name": "address-snapshot",
    },
    {
      "description": "D1: container custom report",
      "name": "container-snapshot",
    },
    {
      "description": "D1: combined report sync",
      "name": "data-snapshot",
    },
    {
      "description": "D1 aggregate reads (customer + address + container) and writes through Routeware with local snapshot sync",
      "name": "data-entity",
    },
  ],
  "webhooks": {},
}
