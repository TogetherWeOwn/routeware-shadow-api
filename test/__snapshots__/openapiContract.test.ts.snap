                    },
                    "upserted": {
                      "type": "integer",
                    },
                  },
                  "required": [
                    "upserted",
                    "rowCount",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Result",
          },
          "401": {
            "description": "Unauthorized",
          },
          "503": {
            "description": "Service Unavailable",
          },
        },
        "summary": "Fetch container report CSV and upsert D1",
        "tags": [
          "container-snapshot",
        ],
      },
    },
