    "/api/v1/health": {
      "get": {
        "description": "The one route the \`/api/v1/*\` bearer gate allows without a token. Returns 200 when the Worker is running; it does not check D1, R2, or report config — that is \`GET /api/v1/readiness\`.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse",
                },
              },
            },
            "description": "Worker is running",
          },
        },
        "security": [],
        "summary": "Liveness probe (public, no bearer)",
        "tags": [
          "meta",
        ],
      },
    },
    "/api/v1/readiness": {
      "get": {
        "description": "Authenticated deploy check: pings D1, reports whether the SNAPSHOTS R2 binding is present, reports whether each snapshot report source is configured, and reports cron staleness (last persisted cron run per table from cron_sync_state; advisory — never flips the overall status). Returns 200 when every check passes, 503 with per-dependency status otherwise. Requires the same bearer as other /api/v1/* routes.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse",
                },
              },
            },
            "description": "All dependencies ready",
          },
          "401": {
            "description": "Unauthorized",
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse",
                },
              },
            },
            "description": "One or more dependencies not ready (per-dependency status in body)",
          },
        },
        "summary": "Deep readiness probe (D1, R2, report config)",
        "tags": [
          "meta",
        ],
      },
    },
    "/api/v1/routeware/account/login-page": {
      "get": {
        "description": "Fetches the fixed \`LOGIN_URL\` with no session — never reads or writes the shared Routeware session, sends no \`Cookie\` upstream, and strips upstream \`Set-Cookie\`. Bearer-gated like every \`/api/v1/*\` route except \`GET /api/v1/health\`; the client query string is never forwarded. See \`docs/PROBLEMS.md\` § login-page fetch.",
        "responses": {
          "200": {
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Upstream HTML for the Routeware login page (unauthenticated fetch)",
          },
        },
        "summary": "Routeware login page (sessionless probe)",
        "tags": [
          "routeware",
        ],
      },
    },
    "/api/v1/routeware/address/save-address-form": {
      "post": {
        "description": "Proxies to WebRW \`SaveAddressForm\` with **application/x-www-form-urlencoded** bodies. **Anti-forgery:** when \`__RequestVerificationToken\` is missing or is a placeholder, the Worker uses the stored Routeware session to GET \`CreateBlankAddress?customerID=\` (create, \`PickupAddressID\` 0 / absent) or \`LoadAddressModal?PickupAddressID=\` (edit), parses the token from HTML, and injects it before forwarding—clients normally do not need to send a token. Set \`CUSTOMER_SAVE_AUTO_TOKEN=false\` to disable. Use \`PickupAddressID=0\` with \`CustomerID\` for create; set \`PickupAddressID\` for updates. Routeware signals a failed save as an HTML error page with HTTP 200 — that shape is surfaced as 502 problem+json, never passed through as 200.",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "example": {
                "Address": "1 Main St",
                "City": "Killeen",
                "CustomerID": "345734",
                "PickupAddressID": "0",
                "State": "TX",
                "Zip": "76541",
              },
              "schema": {
                "properties": {
                  "Address": {
                    "type": "string",
                  },
                  "City": {
                    "type": "string",
                  },
                  "CustomerID": {
                    "type": "string",
                  },
                  "PickupAddressID": {
                    "type": "string",
                  },
                  "State": {
                    "type": "string",
                  },
                  "Zip": {
                    "type": "string",
                  },
                },
                "type": "object",
              },
            },
          },
          "description": "Save fields (application/x-www-form-urlencoded). Omit \`__RequestVerificationToken\` — the Worker fills it server-side. \`PickupAddressID=0\` with \`CustomerID\` creates; set it to update.",
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                },
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                    },
                  },
                  "type": "object",
                },
              },
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Upstream Routeware response (JSON, form-encoded, HTML, or other)",
          },
          "400": {
            "description": "Bad Request (application/problem+json). Empty body where save fields are required, or create (\`PickupAddressID\` 0 / absent) without \`CustomerID\` in the POST body.",
          },
          "502": {
            "description": "Bad Gateway (application/problem+json). Routeware answered with an HTML error page + HTTP 200 instead of a success body.",
          },
        },
        "summary": "SaveAddressForm (create or update)",
        "tags": [
          "address",
        ],
      },
    },
    "/api/v1/routeware/container/save-container-form": {
      "post": {
        "description": "Proxies to WebRW \`SaveContainerForm\` with **application/x-www-form-urlencoded** bodies. **Anti-forgery:** when \`__RequestVerificationToken\` is missing or is a placeholder, the Worker uses the stored Routeware session to GET \`CreateBlankContainer?pickupAddressID=\` (create, \`ContainerID\` 0 / absent) or \`LoadContainerModal?ContainerID=\` (edit), parses the token from HTML, and injects it before forwarding—clients normally do not need to send a token. Set \`CUSTOMER_SAVE_AUTO_TOKEN=false\` to disable. Use \`ContainerID=0\` with \`PickupAddressID\` for create; set \`ContainerID\` for updates. Routeware signals a failed save as an HTML error page with HTTP 200 — that shape is surfaced as 502 problem+json, never passed through as 200.",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "example": {
                "ContainerID": "0",
                "PickupAddressID": "10",
                "SerialNumber": "C-100-A",
              },
              "schema": {
                "properties": {
                  "ContainerID": {
                    "type": "string",
                  },
                  "PickupAddressID": {
                    "type": "string",
                  },
                  "SerialNumber": {
                    "type": "string",
                  },
                },
                "type": "object",
              },
            },
          },
          "description": "Save fields (application/x-www-form-urlencoded). Omit \`__RequestVerificationToken\` — the Worker fills it server-side. \`ContainerID=0\` with \`PickupAddressID\` creates; set it to update.",
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                },
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                    },
                  },
                  "type": "object",
                },
              },
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Upstream Routeware response (JSON, form-encoded, HTML, or other)",
          },
          "400": {
            "description": "Bad Request (application/problem+json). Empty body where save fields are required, or create (\`ContainerID\` 0 / absent) without \`PickupAddressID\` in the POST body.",
          },
          "502": {
            "description": "Bad Gateway (application/problem+json). Routeware answered with an HTML error page + HTTP 200 instead of a success body.",
          },
        },
        "summary": "SaveContainerForm (create or update)",
        "tags": [
          "container",
        ],
      },
    },
    "/api/v1/routeware/customer": {
      "delete": {
        "description": "Routeware WebRW does not expose a hard delete. Disable or retire a customer by submitting \`save-long-form\` with \`Enabled=false\` (and other required fields from the loaded record).",
        "responses": {
          "405": {
            "description": "Method not allowed (application/problem+json). Use save-long-form with Enabled=false to disable.",
          },
        },
        "summary": "Delete customer (not supported upstream)",
        "tags": [
          "customer",
        ],
      },
    },
    "/api/v1/routeware/customer/add-new-long": {
      "get": {
        "description": "Returns the same HTML/JS fragment Routeware uses for the long add-customer modal. Optional for API clients: \`save-long-form\` can fetch this page server-side to obtain \`__RequestVerificationToken\` when you omit the token.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {},
              },
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Upstream Routeware response (JSON, form-encoded, HTML, or other)",
          },
        },
        "summary": "AddNewLong (new customer form shell)",
        "tags": [
          "customer",
        ],
      },
    },
    "/api/v1/routeware/customer/customer-types-read": {
      "post": {
        "description": "Customer type / category list for pickers (same store pattern as other Ext.NET \`*Read\` actions). Send **application/x-www-form-urlencoded** (e.g. \`EnabledOnly=true\`). Request body is not validated here so the Worker can forward the raw body after session middleware consumes the stream once. Routeware signals a failed read silently as an HTML error page with HTTP 200 — that shape is surfaced as 502 problem+json, never passed through as 200.",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "example": {
                "EnabledOnly": "true",
              },
              "schema": {
                "properties": {
                  "EnabledOnly": {
                    "type": "string",
                  },
                },
                "type": "object",
              },
            },
          },
          "description": "Dropdown filter (application/x-www-form-urlencoded). Request body is not validated here so the Worker can forward the raw body.",
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "CustomerType": "Commercial",
                      "CustomerTypeID": 1,
                    },
                  ],
                  "success": true,
                  "total": 1,
                },
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "success": {
                      "type": "boolean",
                    },
                    "total": {
                      "type": "integer",
                    },
                  },
                  "type": "object",
                },
              },
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Upstream Routeware response (JSON, form-encoded, HTML, or other)",
          },
          "502": {
            "description": "Bad Gateway (application/problem+json). Routeware answered with an HTML error page + HTTP 200 instead of a success body.",
          },
        },
        "summary": "CustomerTypesRead",
        "tags": [
          "customer",
        ],
      },
    },
    "/api/v1/routeware/customer/customers-read": {
      "post": {
        "description": "Forwards the JSON body to WebRW \`CustomersRead\` with **application/json** (e.g. the harvested Ext.NET store shape: \`filter\`, \`page\`, \`start\`, \`limit\`, \`group\`, \`sort\`). OData-style \`skip\`/\`take\` keys are translated server-side onto \`start\`/\`limit\` (which upstream is proven to honor via the harvested SPA traffic); an explicit \`start\`/\`limit\` always wins and non-JSON bodies pass through untouched. Routeware signals a failed read silently as an HTML error page with HTTP 200 — that shape is surfaced as 502 problem+json, never passed through as 200.",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "filter": [
                  {
                    "operator": ">",
                    "property": "CustomerID",
                    "value": 0,
                  },
                ],
                "group": "[]",
                "limit": 50,
                "page": 1,
                "sort": "[{"property":"CustomerID","direction":"ASC"}]",
                "start": 0,
              },
              "schema": {
                "properties": {
                  "filter": {
                    "items": {
                      "type": "object",
                    },
                    "type": "array",
                  },
                  "group": {
                    "type": "string",
                  },
                  "limit": {
                    "type": "integer",
                  },
                  "page": {
                    "type": "integer",
                  },
                  "sort": {
                    "type": "string",
                  },
                  "start": {
                    "type": "integer",
                  },
                },
                "type": "object",
              },
            },
          },
          "description": "Ext.NET store read body (JSON). A non-empty \`filter\` avoids the upstream “You need to filter.” error.",
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "data": [
                    {
                      "CompanyName": "ExampleCo",
                      "CustomerID": 345734,
                      "Enabled": true,
                      "Phone1": "555-0100",
                    },
                  ],
                  "success": true,
                  "total": 1,
                },
                "schema": {
                  "properties": {
                    "data": {
                      "items": {
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "success": {
                      "type": "boolean",
                    },
                    "total": {
                      "type": "integer",
                    },
                  },
                  "type": "object",
                },
              },
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Upstream Routeware response (JSON, form-encoded, HTML, or other)",
          },
          "502": {
            "description": "Bad Gateway (application/problem+json). Routeware answered with an HTML error page + HTTP 200 instead of a success body.",
          },
        },
        "summary": "CustomersRead (harvested SPA traffic)",
        "tags": [
          "customer",
        ],
      },
    },
    "/api/v1/routeware/customer/detail-full": {
      "post": {
        "description": "Loads one customer record from WebRW \`GetCustomerDetailFull\` with **application/json** (e.g. \`{"CustomerID": 345734}\` — set a real id). Routeware signals a failed read silently as an HTML error page with HTTP 200 — that shape is surfaced as 502 problem+json, never passed through as 200.",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "CustomerID": 345734,
              },
              "schema": {
                "properties": {
                  "CustomerID": {
                    "type": "integer",
                  },
                },
                "required": [
                  "CustomerID",
                ],
                "type": "object",
              },
            },
          },
          "description": "Customer id to load (JSON).",
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "currentCustomer": {
                    "CompanyName": "ExampleCo",
                    "CustomerID": 345734,
                    "CustomerNumber": "C-1001",
                    "CustomerTypeID": 2,
                    "Enabled": true,
                    "NameFirst": "Jane",
                    "NameLast": "Doe",
                    "NameMI": "",
                    "Phone1": "555-0100",
                  },
                  "data": [
                    {
                      "Address": "1 Main St",
                      "City": "Killeen",
                      "Containers": [
                        {
                          "ContainerID": 100,
                          "PickupAddressID": 10,
                          "SerialNumber": "C-100-A",
                        },
                      ],
                      "CustomerID": 345734,
                      "Enabled": true,
                      "PickupAddressID": 10,
                      "State": "TX",
                      "Zip": "76541",
                    },
                  ],
                },
                "schema": {
                  "properties": {
                    "currentCustomer": {
                      "type": "object",
                    },
                    "data": {
                      "items": {
                        "type": "object",
                      },
                      "type": "array",
                    },
                  },
                  "type": "object",
                },
              },
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Upstream Routeware response (JSON, form-encoded, HTML, or other)",
          },
          "502": {
            "description": "Bad Gateway (application/problem+json). Routeware answered with an HTML error page + HTTP 200 instead of a success body.",
          },
        },
        "summary": "GetCustomerDetailFull",
        "tags": [
          "customer",
        ],
      },
    },
    "/api/v1/routeware/customer/load-long-modal": {
      "get": {
        "description": "Loads the edit-customer long form HTML/JS for the given \`customerID\` query parameter. Only \`customerID\` is forwarded upstream to \`GET /Customer/LoadLongCustomerModal\`; any other query param is silently dropped. \`customerID\` is required and must be a positive integer. Documented in \`docs/PROBLEMS.md\` § query-param allowlist.",
        "parameters": [
          {
            "in": "query",
            "name": "customerID",
            "required": false,
            "schema": {
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {},
              },
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Upstream Routeware response (JSON, form-encoded, HTML, or other)",
          },
          "400": {
            "description": "Missing/invalid customerID (application/problem+json)",
          },
        },
        "summary": "LoadLongCustomerModal (allowlisted query params forwarded upstream)",
        "tags": [
          "customer",
        ],
      },
    },
    "/api/v1/routeware/customer/save-long-form": {
      "post": {
        "description": "Proxies to WebRW \`SaveCustomerLongForm\` with **application/x-www-form-urlencoded** bodies. **Anti-forgery:** when \`__RequestVerificationToken\` is missing or is a placeholder, the Worker uses the stored Routeware session to GET \`AddNewLong\` (create, \`CustomerID\` 0 / absent) or \`LoadLongCustomerModal?customerID=\` (edit), parses the token from HTML, and injects it before forwarding—clients normally do not need to send a token. Set \`CUSTOMER_SAVE_AUTO_TOKEN=false\` to disable. Use \`CustomerID=0\` for create; set \`CustomerID\` for updates. Disable customers with \`Enabled=false\` (no upstream delete). Routeware signals a failed save as an HTML error page with HTTP 200 — that shape is surfaced as 502 problem+json, never passed through as 200.",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "example": {
                "CompanyName": "ExampleCo",
                "CustomerID": "0",
                "CustomerTypeID": "1",
                "Enabled": "true",
                "FirstName": "Jane",
                "LastName": "Doe",
              },
              "schema": {
                "properties": {
                  "CompanyName": {
                    "type": "string",
                  },
                  "CustomerID": {
                    "type": "string",
                  },
                  "CustomerTypeID": {
                    "type": "string",
                  },
                  "Enabled": {
                    "type": "string",
                  },
                  "FirstName": {
                    "type": "string",
                  },
                  "LastName": {
                    "type": "string",
                  },
                },
                "type": "object",
              },
            },
          },
          "description": "Save fields (application/x-www-form-urlencoded). Omit \`__RequestVerificationToken\` — the Worker fills it server-side from the Routeware modal. \`CustomerID=0\` creates; set it to update; \`Enabled=false\` disables.",
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                },
                "schema": {
                  "properties": {
                    "success": {
                      "type": "boolean",
                    },
                  },
                  "type": "object",
                },
              },
              "text/html": {
                "schema": {
                  "type": "string",
                },
              },
              "text/plain": {
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "Upstream Routeware response (JSON, form-encoded, HTML, or other)",
          },
          "400": {
            "description": "Bad Request (application/problem+json). Empty body where save fields are required.",
          },
          "502": {
            "description": "Bad Gateway (application/problem+json). Routeware answered with an HTML error page + HTTP 200 instead of a success body.",
          },
        },
        "summary": "SaveCustomerLongForm (create or update)",
        "tags": [
          "customer",
        ],
      },
    },
    "/api/v1/routeware/data/app-settings-get": {
      "post": {
        "description": "Reads WebRW \`Data/appSettingsGet\` with **application/json** (the harvested body is \`{}\`). Routeware signals a failed read silently as an HTML error page with HTTP 200 — that shape is surfaced as 502 problem+json, never passed through as 200.",
