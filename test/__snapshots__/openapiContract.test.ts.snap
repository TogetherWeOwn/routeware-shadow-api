        },
        "summary": "Get address (D1) with customer and containers",
        "tags": [
          "data-entity",
        ],
      },
      "post": {
        "description": "Proxies to \`PickupAddress/SaveAddressForm\` with **application/x-www-form-urlencoded**. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. New address: \`PickupAddressID=0\` and \`CustomerID\` set; anti-forgery from \`CreateBlankAddress\`. Response: \`ok\`, \`routewareStatus\`, \`customerId\`, \`pickupAddressId\`, \`upstreamBytes\`, \`localSync\` (ids + fixed \`code\` outcomes only — no submitted fields, no upstream body). Creates (posted id 0/absent, upstream ok) answer 201 with the resolved \`pickupAddressId\` — upstream \`data.PickupAddressID\` first, else the singleton post-refresh D1 id for the owning customer; \`null\` remains when no upstream id is available and the diff is empty, ambiguous (0 or 2+ new ids), or unavailable (unknown owner or failed baseline/refresh). Updates echo the posted id with 200. No \`Location\` header: the by-id snapshot URL may not exist locally when the refresh fails, and a header that 404s is worse than none. Dry-run saves echo posted ids while live saves resolve (R21-02 convergence). Pass \`?dryRun=true\` to validate only — same admission and validation, zero upstream/D1/cache writes, \`dryRun: true\` in the response; without a usable session the dry-run fails closed with 503 and never logs in. Only \`dryRun\` is an allowed query key.",
        "parameters": [
          {
            "description": "Dry run: run validation only and persist nothing — no upstream write, no D1 write, no R2 write, no cache invalidation. Mutating snapshot POSTs reject any other query key with a value-free 400 before any work.",
            "in": "query",
            "name": "dryRun",
            "required": false,
            "schema": {
              "description": "Dry run: run validation only and persist nothing — no upstream write, no D1 write, no R2 write, no cache invalidation. Mutating snapshot POSTs reject any other query key with a value-free 400 before any work.",
              "enum": [
                "true",
                "false",
              ],
              "example": "true",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "example": {
                "Address": "1 Main St",
                "CustomerID": "5",
                "PickupAddressID": "0",
              },
              "schema": {
                "properties": {
                  "Address": {
                    "type": "string",
                  },
                  "CustomerID": {
                    "type": "string",
                  },
                  "PickupAddressID": {
                    "type": "string",
                  },
                  "__RequestVerificationToken": {
                    "type": "string",
                  },
                },
                "type": "object",
              },
            },
          },
          "description": "SaveAddressForm fields — token injected server-side when omitted (see example)",
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "dryRun": {
                    "summary": "Validation passed only; no upstream write or local refresh (synthetic)",
                    "value": {
                      "customerId": 5,
                      "dryRun": true,
                      "localSync": {
                        "code": "not_attempted",
                        "done": false,
                      },
                      "ok": true,
                      "pickupAddressId": 10,
                      "routewareStatus": null,
                      "upstreamBytes": 0,
                    },
                  },
                  "refreshed": {
                    "summary": "Upstream accepted; local graph refreshed (synthetic)",
                    "value": {
                      "customerId": 5,
                      "localSync": {
                        "addressIds": [
                          10,
                        ],
                        "containerIds": [
                          100,
                        ],
                        "customerId": 5,
                        "done": true,
                      },
                      "ok": true,
                      "pickupAddressId": 10,
                      "routewareStatus": 200,
                      "upstreamBytes": 16,
                    },
                  },
                  "rejected": {
                    "summary": "Upstream rejected despite HTTP 200; no local refresh (synthetic)",
                    "value": {
                      "customerId": 5,
                      "localSync": {
                        "code": "not_attempted",
                        "done": false,
                      },
                      "ok": false,
                      "pickupAddressId": 10,
                      "routewareStatus": 200,
                      "upstreamBytes": 17,
                    },
                  },
                  "syncFailed": {
                    "summary": "Upstream accepted; local refresh or invalidation failed (synthetic)",
                    "value": {
                      "customerId": 5,
                      "localSync": {
                        "code": "sync_failed",
                        "done": false,
                      },
                      "ok": true,
                      "pickupAddressId": 10,
                      "routewareStatus": 200,
                      "upstreamBytes": 16,
                    },
                  },
                  "unknownCustomer": {
                    "summary": "Upstream accepted; owning customer unresolved (synthetic)",
                    "value": {
                      "customerId": null,
                      "localSync": {
                        "code": "unknown_customer_id",
                        "done": false,
                      },
                      "ok": true,
                      "pickupAddressId": 10,
                      "routewareStatus": 200,
                      "upstreamBytes": 16,
                    },
                  },
                },
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/AddressSaveOutcome",
                    },
                    {
                      "$ref": "#/components/schemas/AddressSaveDryRun",
                    },
                  ],
                },
              },
            },
            "description": "Save or validation-only outcome, not an unconditional success claim. dryRun=true means validation passed with no upstream write, routewareStatus=null, upstreamBytes=0 and localSync.code=not_attempted. On live saves, ok=true with localSync.done=true means upstream acceptance and local refresh; ok=true with done=false means acceptance without completed refresh. ok=false means upstream rejection even on HTTP 200; localSync.code=not_attempted. Never echoes submitted fields or the upstream body. Local refresh is best-effort: HTTP 200 does not guarantee a refreshed local graph. Read ok and localSync separately. Never blindly retry or replay creates after an ambiguous outcome or failed refresh: the upstream write may already have landed. Verify existing IDs and reconcile local state without repeating the create.",
          },
          "201": {
            "content": {
              "application/json": {
                "example": {
                  "customerId": 5,
                  "localSync": {
                    "addressIds": [
                      10,
                      77,
                    ],
                    "containerIds": [
                      100,
                    ],
                    "customerId": 5,
                    "done": true,
                  },
                  "ok": true,
                  "pickupAddressId": 77,
                  "routewareStatus": 200,
                  "upstreamBytes": 46,
                },
                "schema": {
                  "$ref": "#/components/schemas/AddressSaveOutcome",
                },
              },
            },
            "description": "Address created (posted id 0/absent, upstream ok) + resolved pickupAddressId + local D1 sync summary (synthetic example). The id comes from upstream data.PickupAddressID, else the singleton post-refresh D1 id for the owning customer; null remains when no upstream id is available and the diff is empty, ambiguous, or unavailable (unknown owner or failed baseline/refresh).",
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressSaveOutcome",
                },
              },
              "application/problem+json": {
                "schema": {
                  "properties": {
                    "detail": {
                      "type": "string",
                    },
                    "instance": {
                      "type": "string",
                    },
                    "requestId": {
                      "type": "string",
                    },
                    "status": {
                      "type": "integer",
                    },
                    "title": {
                      "type": "string",
                    },
                    "type": {
                      "type": "string",
                    },
