              "type": [
                "integer",
                "null",
              ],
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {},
                  "type": "object",
                },
              },
            },
            "description": "Row",
          },
          "400": {
            "description": "Invalid customer id (application/problem+json)",
          },
          "404": {
            "description": "Not found (application/problem+json)",
          },
        },
        "summary": "Get one customer snapshot row",
        "tags": [
          "customer-snapshot",
        ],
      },
    },
    "/api/v1/data-snapshot/orphans": {
      "get": {
        "description": "D1 declares \`address_snapshot.customer_id\` → \`customer_snapshot\` and \`container_snapshot.pickup_address_id\` → \`address_snapshot\` but enforces neither, and a streamed sync spans many batches — so address rows can lack a customer and container rows can lack an address. Returns per-edge orphan counts plus deterministic id samples (ordered by primary key). Same bearer as other snapshot routes.",
        "parameters": [
          {
            "description": "Max ids sampled per edge (counts are unaffected). Out-of-range values are rejected before D1 is touched.",
            "in": "query",
            "name": "sampleLimit",
            "required": false,
            "schema": {
              "default": 100,
              "description": "Max ids sampled per edge (counts are unaffected). Out-of-range values are rejected before D1 is touched.",
              "maximum": 500,
              "minimum": 1,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SnapshotOrphanReport",
                },
              },
            },
            "description": "Orphan counts and id samples per FK edge",
          },
          "401": {
            "description": "Unauthorized",
          },
        },
        "summary": "Report orphan rows on the snapshot FK chain (D1)",
        "tags": [
          "data-snapshot",
        ],
      },
    },
    "/api/v1/data-snapshot/sync": {
      "post": {
        "description": "Runs **customer** → **address** → **container** when the corresponding \`*_REPORT_EXPORT_PATH\` or \`*_REPORT_QUERY_ID\` vars are set. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. This route **chains three internal HTTP calls** to the per-table \`...-snapshot/sync\` routes (via the request origin) so each table runs in a **separate** Worker invocation (D1’s per-invocation operation limit applies per table, not to the whole job). The daily cron uses the same chained path only when \`SHADOW_API_PUBLIC_BASE\` is set (otherwise it falls back to one single-invocation run — see \`src/scheduled.ts\`). Each table is streamed; see \`CUSTOMER_SNAPSHOT.md\`.

**Try it in \`/docs\`:** Authorize with the sync secret once, then Send with an empty body — this is the highest-friction flow made one click. Per-table 200s carry \`{upserted, rowCount}\` only (no \`deleted\` leak); a table with no export source comes back \`null\`, not zeros.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "address": {
                    "rowCount": 2,
                    "upserted": 2,
                  },
                  "container": {
                    "rowCount": 2,
                    "upserted": 2,
                  },
                  "customer": {
                    "rowCount": 2,
                    "upserted": 2,
                  },
                },
                "schema": {
                  "$ref": "#/components/schemas/DataSnapshotSyncResult",
                },
              },
            },
            "description": "Per-table Result (null if that export path is empty or was skipped for FKs)",
          },
          "401": {
            "description": "Unauthorized",
          },
        },
        "summary": "Fetch all configured Routeware CSV reports and upsert D1 (ordered)",
        "tags": [
          "data-snapshot",
        ],
      },
    },
    "/api/v1/data/address": {
      "get": {
        "description": "Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. Read aggregate from the daily snapshot DB. Caching: \`ETag\` / \`If-None-Match\` and the Workers **Cache** API; invalidated after successful POST. Query: \`id\` = \`pickup_address_id\`.",
