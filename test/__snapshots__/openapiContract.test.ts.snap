    "/api/v1/address-snapshot": {
      "get": {
        "description": "Routeware addresses (\`PickupAddressID\` → \`CustomerID\`). Optional filters: \`customerId\`, \`pickupAddressId\`, free-text on street \`q\`, \`enabled\`.",
        "parameters": [
          {
            "in": "query",
            "name": "customerId",
            "required": false,
            "schema": {
              "type": [
