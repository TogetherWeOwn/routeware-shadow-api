    "/api/v1/data/customer": {
      "get": {
        "description": "Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. Read aggregate from the daily snapshot DB. Caching: \`ETag\` / \`If-None-Match\` and the Workers **Cache** API; invalidated after successful POST. Query: \`id\` = \`customer_id\` (alias \`customerId\`).",
        "parameters": [
          {
            "in": "query",
            "name": "id",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null",
              ],
            },
          },
          {
            "in": "query",
            "name": "customerId",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null",
              ],
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {},
              },
            },
            "description": "customer + nested addresses with containers",
          },
          "304": {
            "description": "Not modified",
          },
          "400": {
            "description": "Missing id",
          },
          "401": {
            "description": "Unauthorized",
          },
          "404": {
            "description": "Not in D1",
          },
        },
        "summary": "Get customer (D1) with addresses and containers",
        "tags": [
          "data-entity",
        ],
      },
      "post": {
        "description": "Proxies to \`SaveCustomerLongForm\` (same as \`/api/v1/routeware/customer/save-long-form\`). \`CustomerID=0\` or absent for create. On success, refreshes D1 for that customer from \`GetCustomerDetailFull\` and invalidates related cache entries. Response: \`upstream\` (Routeware body), \`posted\` (form fields you sent), \`ok\`, \`localSync\`.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {},
              },
            },
            "description": "Routeware response + \`posted\` fields + optional local D1 sync summary",
          },
          "400": {
            "description": "Bad request",
          },
          "401": {
            "description": "Unauthorized",
          },
          "502": {
            "description": "Token preparation failed",
          },
        },
        "summary": "Create/update customer in Routeware + sync D1",
        "tags": [
          "data-entity",
        ],
      },
    },
