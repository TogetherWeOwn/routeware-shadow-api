    "/api/v1/container-snapshot/sync": {
      "post": {
        "description": "Same bearer. Requires \`CONTAINER_REPORT_EXPORT_PATH\` or \`CONTAINER_REPORT_QUERY_ID\`. Address rows for each \`pickup_address_id\` should exist in D1 first.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "deleted": {
                      "type": "integer",
                    },
                    "rowCount": {
                      "type": "integer",
                    },
                    "skipped": {
                      "type": "boolean",
                    },
                    "upserted": {
                      "type": "integer",
                    },
                  },
                  "required": [
                    "upserted",
                    "rowCount",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Result",
          },
          "401": {
            "description": "Unauthorized",
          },
          "503": {
            "description": "Service Unavailable",
          },
        },
        "summary": "Fetch container report CSV and upsert D1",
        "tags": [
          "container-snapshot",
        ],
      },
    },
    "/api/v1/container-snapshot/{containerId}": {
      "get": {
        "description": "Reads one row from the daily snapshot DB by \`containerId\`. Bearer-gated like every \`/api/v1/*\` route except \`GET /api/v1/health\`. Returns 404 when no row exists for that id.",
        "parameters": [
          {
            "in": "path",
            "name": "containerId",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null",
              ],
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {},
                  "type": "object",
                },
              },
            },
            "description": "Row",
          },
          "400": {
            "description": "Invalid id (application/problem+json)",
          },
          "404": {
            "description": "Not found (application/problem+json)",
          },
        },
        "summary": "Get one container snapshot row",
        "tags": [
          "container-snapshot",
        ],
      },
    },
    "/api/v1/customer-snapshot": {
      "get": {
        "description": "Reads the cached Routeware customer CSV (see \`CUSTOMER_SNAPSHOT.md\`). Filter by \`customerId\`, company substring \`q\`, or \`enabled\`. Pass \`cursor\` (the previous page's \`nextCursor\`) instead of \`offset\` to page deep result sets by primary-key seek instead of a scanned OFFSET.",
        "parameters": [
          {
            "in": "query",
            "name": "customerId",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null",
              ],
            },
          },
          {
            "description": "Company name substring (case-insensitive)",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "description": "Company name substring (case-insensitive)",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "enabled",
            "required": false,
            "schema": {
              "default": "any",
              "enum": [
                "true",
                "false",
                "any",
              ],
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "type": [
                "integer",
                "null",
              ],
            },
          },
          {
            "description": "Last customer_id from the previous page's nextCursor; takes precedence over offset",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "Last customer_id from the previous page's nextCursor; takes precedence over offset",
              "type": [
                "integer",
                "null",
              ],
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerSnapshotList",
                },
              },
            },
            "description": "Rows and total count for pagination",
          },
          "400": {
            "description": "Invalid query (application/problem+json). The zod validator rejects an out-of-range \`limit\`/\`offset\` or an unknown \`enabled\` value before any D1 query runs.",
          },
        },
        "summary": "List customer snapshot rows (D1)",
        "tags": [
          "customer-snapshot",
        ],
      },
    },
    "/api/v1/customer-snapshot/export": {
      "get": {
        "description": "Streams every \`customer_snapshot\` row as CSV (\`Content-Disposition: attachment\`, filename \`customer-snapshot.csv\`) in \`customer_id\` order. Reads in keyset pages so a full-table export never buffers the table in memory. Emits a content-hash \`ETag\`; replay it as \`If-None-Match\` for a \`304\` with an empty body. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`.",
        "responses": {
          "200": {
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "CSV download (header line plus one line per row)",
          },
          "304": {
            "description": "Not modified (If-None-Match carries the current ETag)",
          },
          "401": {
            "description": "Unauthorized",
          },
        },
        "summary": "Download customer snapshot as CSV",
        "tags": [
          "customer-snapshot",
        ],
      },
    },
    "/api/v1/customer-snapshot/import": {
      "post": {
        "description": "Raw CSV bytes (same format as the Routeware export). \`Content-Type: text/csv\` or \`application/octet-stream\`. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`.

**Try it in \`/docs\`:** Authorize with the sync secret once, paste the request example below as the raw body, then Send. A 200 looks like \`{upserted: 2, rowCount: 2, deleted: 0}\` — imports never delete, so \`deleted\` is always 0. Run this before the address/container imports so their foreign keys resolve.",
        "requestBody": {
          "content": {
            "text/csv": {
              "example": "CustomerID,CustomerTypeID,CompanyName,FirstName,MiddleInitial,LastName,NameSuffix,CustomerNumber,SubCustomerNumber,Phone1,Phone2,Comments,Enabled
123,,Co 123,Jane,,Doe,,,,,,,true",
              "schema": {
                "type": "string",
              },
            },
          },
          "description": "Routeware customer CSV (header + data rows — see example)",
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "deleted": 0,
                  "rowCount": 2,
                  "upserted": 2,
                },
                "schema": {
                  "properties": {
                    "deleted": {
                      "type": "integer",
                    },
                    "rowCount": {
                      "type": "integer",
                    },
                    "upserted": {
                      "type": "integer",
                    },
                  },
                  "required": [
                    "upserted",
                    "rowCount",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Import result",
          },
          "400": {
            "description": "Empty body (application/problem+json). Returned when the POST has no request body; post the CSV file as the raw request body.",
          },
          "401": {
            "description": "Unauthorized",
          },
        },
        "summary": "Import CSV body into D1",
        "tags": [
          "customer-snapshot",
        ],
      },
    },
    "/api/v1/customer-snapshot/sync": {
      "post": {
        "description": "Same logic as the daily cron. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\` and either \`CUSTOMER_REPORT_EXPORT_PATH\` (static path) or \`CUSTOMER_REPORT_QUERY_ID\` (Routeware query id for the async report pipeline).

**Try it in \`/docs\`:** paste the sync secret once into the \`bearerAuth\` Authorize dialog (it persists across calls), then Send with an empty body. A 200 looks like the example: \`{upserted, rowCount, deleted}\` (\`skipped: true\` instead when no export source is configured). Import customers before addresses/containers so foreign keys resolve.",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "deleted": 0,
                  "rowCount": 2,
                  "upserted": 2,
                },
                "schema": {
                  "properties": {
                    "deleted": {
                      "type": "integer",
                    },
                    "rowCount": {
                      "type": "integer",
                    },
                    "skipped": {
                      "type": "boolean",
                    },
                    "upserted": {
                      "type": "integer",
                    },
                  },
                  "required": [
                    "upserted",
                    "rowCount",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Sync result",
          },
          "401": {
            "description": "Missing or invalid bearer token",
          },
          "503": {
            "description": "Service Unavailable",
          },
        },
        "summary": "Fetch Routeware report CSV and upsert D1",
        "tags": [
          "customer-snapshot",
        ],
      },
    },
    "/api/v1/customer-snapshot/{customerId}": {
      "get": {
        "description": "Reads one row from the daily snapshot DB by \`customerId\`. Bearer-gated like every \`/api/v1/*\` route except \`GET /api/v1/health\`. Returns 404 when no row exists for that id.",
        "parameters": [
          {
            "in": "path",
            "name": "customerId",
