    "/api/v1/customer-snapshot": {
      "get": {
        "description": "Reads the cached Routeware customer CSV (see \`CUSTOMER_SNAPSHOT.md\`). Filter by \`customerId\`, company substring \`q\`, or \`enabled\`. Pass \`cursor\` (the previous page's \`nextCursor\`) instead of \`offset\` to page deep result sets by primary-key seek instead of a scanned OFFSET. **Try it:** authorize with \`SHADOW_API_TOKEN\` (or \`SHADOW_API_READ_TOKEN\` for GET-only access), select Test Request, and Send with \`limit=10\` and \`enabled=true\`. This only reads local D1; it does not import, sync, or contact Routeware.",
        "operationId": "listCustomerSnapshot",
        "parameters": [
          {
            "in": "query",
            "name": "customerId",
            "required": false,
            "schema": {
              "example": 345734,
              "type": [
                "integer",
                "null",
              ],
            },
          },
          {
            "description": "Company name substring (case-insensitive; maximum 100 Unicode code points)",
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "description": "Company name substring (case-insensitive; maximum 100 Unicode code points)",
              "example": "ExampleCo",
              "maxLength": 100,
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "enabled",
            "required": false,
            "schema": {
              "default": "any",
              "enum": [
                "true",
                "false",
                "any",
              ],
              "example": "true",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "example": 10,
              "maximum": 500,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "example": 0,
              "minimum": 0,
              "type": [
                "integer",
                "null",
              ],
            },
          },
          {
            "description": "Last customer_id from the previous page's nextCursor; takes precedence over offset",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "description": "Last customer_id from the previous page's nextCursor; takes precedence over offset",
              "example": 345733,
              "type": [
                "integer",
                "null",
              ],
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "nextCursor": null,
                  "rows": [
                    {
                      "comments": null,
                      "company_name": "ExampleCo",
                      "customer_id": 345734,
                      "customer_number": "C-1001",
                      "customer_type_id": 1,
                      "enabled": 1,
                      "first_name": "Jane",
                      "last_name": "Doe",
                      "middle_initial": null,
                      "name_suffix": null,
                      "phone1": "555-0100",
                      "phone2": null,
                      "sub_customer_number": null,
                      "synced_at": "2026-01-01T00:00:00.000Z",
                    },
                  ],
                  "total": 1,
                },
                "schema": {
                  "$ref": "#/components/schemas/CustomerSnapshotList",
                },
              },
            },
            "description": "Rows and total count for pagination",
          },
          "400": {
            "description": "Invalid query (application/problem+json). The zod validator rejects \`q\` longer than 100 Unicode code points, an out-of-range \`limit\`/\`offset\`, or an unknown \`enabled\` value before any D1 query runs.",
          },
        },
        "summary": "List customer snapshot rows (D1)",
        "tags": [
          "customer-snapshot",
        ],
      },
    },
    "/api/v1/customer-snapshot/changes": {
      "get": {
        "description": "Incremental-sync feed: returns rows with \`synced_at > since\` in \`(synced_at, customer_id)\` keyset order. Omit \`since\` for the first page (equivalent to the epoch — every row is newer). A bare \`since\` replays every later run whole. To page a chunked delta, pass the previous page's \`nextCursor\` back as \`since\` + \`since_id\`: the composite pair resumes at the boundary timestamp without skipping same-timestamp rows past the page boundary. \`limit\` caps the page at 1..500 (default 50). Rows carry only the stored snapshot columns — no fields beyond the row payload.",
        "parameters": [
          {
            "description": "ISO-8601 cursor; only rows with synced_at after it are returned (plus the since_id tiebreak when paging). Omit for the first page.",
            "in": "query",
            "name": "since",
            "required": false,
            "schema": {
              "description": "ISO-8601 cursor; only rows with synced_at after it are returned (plus the since_id tiebreak when paging). Omit for the first page.",
              "example": "2025-12-31T00:00:00.000Z",
              "format": "date-time",
              "type": "string",
            },
          },
          {
            "description": "Tiebreak half of the composite cursor: the last row's customer_id from the previous page's nextCursor. Omit for the first page and for whole-run replays with a bare \`since\`.",
            "in": "query",
            "name": "since_id",
            "required": false,
            "schema": {
              "description": "Tiebreak half of the composite cursor: the last row's customer_id from the previous page's nextCursor. Omit for the first page and for whole-run replays with a bare \`since\`.",
              "example": 345733,
              "minimum": 0,
              "type": [
                "integer",
                "null",
              ],
            },
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "example": 50,
              "maximum": 500,
              "minimum": 1,
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "nextCursor": null,
                  "rows": [
                    {
                      "comments": null,
                      "company_name": "ExampleCo",
                      "customer_id": 345734,
                      "customer_number": "C-1001",
                      "customer_type_id": 1,
                      "enabled": 1,
                      "first_name": "Jane",
                      "last_name": "Doe",
                      "middle_initial": null,
                      "name_suffix": null,
                      "phone1": "555-0100",
                      "phone2": null,
                      "sub_customer_number": null,
                      "synced_at": "2026-01-01T00:00:00.000Z",
                    },
                  ],
                  "total": 1,
                },
                "schema": {
                  "$ref": "#/components/schemas/CustomerSnapshotChanges",
                },
              },
            },
            "description": "Changed rows in (synced_at, customer_id) order with nextCursor",
          },
        },
        "summary": "List customer snapshot rows changed since a cursor (D1)",
        "tags": [
          "customer-snapshot",
        ],
      },
    },
    "/api/v1/customer-snapshot/export": {
      "get": {
        "description": "Streams every \`customer_snapshot\` row as CSV (\`Content-Disposition: attachment\`, filename \`customer-snapshot.csv\`) in \`customer_id\` order. Reads in keyset pages so a full-table export never buffers the table in memory. Emits a content-hash \`ETag\`; replay it as \`If-None-Match\` for a \`304\` with an empty body. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`.",
        "responses": {
          "200": {
            "content": {
              "text/csv": {
                "example": "CustomerID,CustomerTypeID,CompanyName,FirstName,MiddleInitial,LastName,NameSuffix,CustomerNumber,SubCustomerNumber,Phone1,Phone2,Comments,Enabled,_shadow_csv_encoding,synced_at
345734,1,ExampleCo,Jane,,Doe,,C-1001,,555-0100,,,true,1,2026-01-01T00:00:00.000Z
",
                "schema": {
                  "type": "string",
                },
              },
            },
            "description": "CSV download (header line plus one line per row)",
          },
          "304": {
            "description": "Not modified (If-None-Match carries the current ETag)",
          },
          "401": {
            "description": "Unauthorized",
          },
        },
        "summary": "Download customer snapshot as CSV",
        "tags": [
          "customer-snapshot",
        ],
      },
    },
    "/api/v1/customer-snapshot/import": {
      "post": {
        "description": "Raw CSV bytes (same format as the Routeware export). \`Content-Type: text/csv\` or \`application/octet-stream\`. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. Pass \`?dryRun=true\` to validate and return the would-be counts without writing D1.

**Try it in \`/docs\`:** Authorize with the sync secret once, paste the request example below as the raw body, then Send. A 200 looks like \`{upserted: 2, rowCount: 2, deleted: 0}\` — imports never delete, so \`deleted\` is always 0. Run this before the address/container imports so their foreign keys resolve.",
        "parameters": [
          {
            "description": "Dry run: validate the CSV and return the would-be counts without writing D1 or R2",
            "in": "query",
            "name": "dryRun",
            "required": false,
            "schema": {
              "description": "Dry run: validate the CSV and return the would-be counts without writing D1 or R2",
              "enum": [
                "true",
                "false",
              ],
              "example": "true",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
              },
            },
            "text/csv": {
              "example": "CustomerID,CustomerTypeID,CompanyName,FirstName,MiddleInitial,LastName,NameSuffix,CustomerNumber,SubCustomerNumber,Phone1,Phone2,Comments,Enabled
123,,Co 123,Jane,,Doe,,,,,,,true",
              "schema": {
                "type": "string",
              },
            },
          },
          "description": "Routeware customer CSV (header + data rows — see example)",
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "deleted": 0,
                  "rowCount": 2,
                  "upserted": 2,
                },
                "schema": {
                  "properties": {
                    "deleted": {
                      "type": "integer",
                    },
                    "rowCount": {
                      "type": "integer",
                    },
                    "upserted": {
                      "type": "integer",
                    },
                  },
                  "required": [
                    "upserted",
                    "rowCount",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Import result",
          },
          "400": {
            "description": "Empty body (application/problem+json). Returned when the POST has no request body; post the CSV file as the raw request body.",
          },
          "401": {
            "description": "Unauthorized",
          },
          "415": {
            "description": "Unsupported Content-Type (application/problem+json)",
          },
        },
        "summary": "Import CSV body into D1",
        "tags": [
          "customer-snapshot",
        ],
      },
    },
    "/api/v1/customer-snapshot/sync": {
      "post": {
        "description": "Same logic as the daily cron. Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\` and either \`CUSTOMER_REPORT_EXPORT_PATH\` (static path) or \`CUSTOMER_REPORT_QUERY_ID\` (Routeware query id for the async report pipeline). Pass \`?dryRun=true\` to run the full parse/validate path, return the counts that WOULD apply, and write nothing (no D1, no R2).

**Try it in \`/docs\`:** paste the sync secret once into the \`bearerAuth\` Authorize dialog (it persists across calls), then Send with an empty body. A 200 looks like the example: \`{upserted, rowCount, deleted}\` (\`skipped: true\` instead when no export source is configured). Import customers before addresses/containers so foreign keys resolve.",
        "parameters": [
          {
            "description": "Dry run: validate the CSV and return the would-be counts without writing D1 or R2",
            "in": "query",
            "name": "dryRun",
            "required": false,
            "schema": {
              "description": "Dry run: validate the CSV and return the would-be counts without writing D1 or R2",
              "enum": [
                "true",
                "false",
              ],
              "example": "true",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "deleted": 0,
                  "rowCount": 2,
                  "upserted": 2,
                },
                "schema": {
                  "properties": {
                    "deleted": {
                      "type": "integer",
                    },
                    "rowCount": {
                      "type": "integer",
                    },
                    "skipped": {
                      "type": "boolean",
                    },
                    "upserted": {
                      "type": "integer",
                    },
                  },
                  "required": [
                    "upserted",
                    "rowCount",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Sync result",
          },
          "401": {
            "description": "Missing or invalid bearer token",
          },
          "503": {
            "description": "Service Unavailable",
          },
        },
        "summary": "Fetch Routeware report CSV and upsert D1",
        "tags": [
          "customer-snapshot",
        ],
      },
    },
    "/api/v1/customer-snapshot/{customerId}": {
      "delete": {
        "description": "Hard-deletes one \`customer_snapshot\` row by \`customerId\` (GDPR-style erasure for the cached report extract — upstream Routeware is untouched). Requires \`Authorization: Bearer <CUSTOMER_SNAPSHOT_SYNC_SECRET>\`. Returns 404 when no row exists. Refuses with 400 \`bad-request\` when address rows still reference the customer — delete the addresses first; the D1 foreign key is never bypassed. A successful delete also evicts the cached data-entity customer bundle so the erased PII stops serving immediately.",
        "parameters": [
          {
            "in": "path",
            "name": "customerId",
