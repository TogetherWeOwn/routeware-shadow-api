        },
        "summary": "Download container snapshot as CSV",
        "tags": [
          "container-snapshot",
        ],
      },
    },
    "/api/v1/container-snapshot/import": {
      "post": {
        "description": "Raw CSV; \`Content-Type: text/csv\` or \`application/octet-stream\`. Bear the same secret. Import or sync **addresses** (and **customers**) first for \`pickup_address_id\` foreign keys. Pass \`?dryRun=true\` to validate and return the would-be counts without writing D1.",
        "parameters": [
          {
            "description": "Dry run: validate the CSV and return the would-be counts without writing D1 or R2",
            "in": "query",
            "name": "dryRun",
            "required": false,
            "schema": {
              "description": "Dry run: validate the CSV and return the would-be counts without writing D1 or R2",
              "enum": [
                "true",
                "false",
              ],
              "example": "true",
              "type": "string",
            },
          },
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
              },
            },
            "text/csv": {
              "example": "ContainerID,PickupAddressID,ContainerTypeID,SerialNumber,RFID,OnCall,EventCode,GPSLocked,Latitude,Longitude,Enabled,Address,City,State,Zip,ContainerNote
100,10,,SN-100,,false,,false,,,true,1 Main St,Killeen,TX,76541,",
              "schema": {
                "type": "string",
              },
            },
          },
          "description": "Routeware Container Details CSV (header + data rows — see example)",
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "deleted": 0,
                  "rowCount": 2,
                  "upserted": 2,
                },
                "schema": {
                  "properties": {
                    "deleted": {
                      "type": "integer",
                    },
                    "rowCount": {
                      "type": "integer",
                    },
                    "upserted": {
                      "type": "integer",
                    },
                  },
                  "required": [
                    "upserted",
                    "rowCount",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "Result",
          },
          "400": {
            "description": "Empty body (application/problem+json). Returned when the POST has no request body; post the CSV as the raw request body.",
          },
          "401": {
            "description": "Unauthorized",
          },
          "415": {
            "description": "Unsupported Content-Type (application/problem+json)",
          },
        },
        "summary": "Import container CSV into D1",
        "tags": [
          "container-snapshot",
        ],
      },
    },
    "/api/v1/container-snapshot/sync": {
      "post": {
        "description": "Same bearer. Requires \`CONTAINER_REPORT_EXPORT_PATH\` or \`CONTAINER_REPORT_QUERY_ID\`. Address rows for each \`pickup_address_id\` should exist in D1 first. Pass \`?dryRun=true\` to run the full parse/validate path, return the counts that WOULD apply, and write nothing (no D1, no R2).",
        "parameters": [
