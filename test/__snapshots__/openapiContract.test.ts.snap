            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "type": "integer",
            },
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
