node_modules/
.wrangler/
.dev.vars
*.log
dist/
coverage/
tools/api-discovery/out/
tools/api-discovery/.harvest.ndjson

# Routeware report exports may contain real customer/address/container data (PII).
# Never commit them. Keep small sample fixtures under tools/api-discovery/examples/.
*.csv
*:Zone.Identifier

# ECC agent-harness install (.claude/) is vendored third-party content, not project
# source: ~7 MB of agents/skills/commands/scripts already provided by the user-level
# `ecc@ecc` plugin. Track only what is project-specific:
#   - settings.json — the deny list enforcing "deploys are not yours to run"
#   - rules/ecc/typescript — the path-scoped stack pack, the only ruleset tracked
# The language-agnostic `rules/ecc/common/` pack is deliberately NOT tracked: it is
# always-on context that forks from the live user-scope copy. Dropped in 2713fed —
# do not add a negation for it back.
.claude/*
!.claude/settings.json
!.claude/rules/
.claude/rules/*
!.claude/rules/ecc/
.claude/rules/ecc/*
!.claude/rules/ecc/typescript/
# Per-developer overrides must never be committed.
.claude/settings.local.json
