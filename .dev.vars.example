# Copy to .dev.vars (gitignored). Never commit real values.
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Client auth for /api/v1/* (all routes except GET /api/v1/health).
# SHADOW_API_TOKEN falls back to CUSTOMER_SNAPSHOT_SYNC_SECRET when unset.
# At least one of these must be set (non-empty) or every /api/v1/* call returns 401.
SHADOW_API_TOKEN=
CUSTOMER_SNAPSHOT_SYNC_SECRET=

# Optional: session auth method. Default "auto" (HTTP form login, browser fallback).
# HTTP login needs no Browser Rendering, so `npm run dev` (local) works without --remote.
# Set "browser" to force the Puppeteer path, or "http" to disable the fallback.
# AUTH_MODE=auto

# Optional: override for staging
# TARGET_ORIGIN=https://example.routeware.com

# Local API docs: deployed envs default OPENAPI_DOCS_ENABLED to "false"
# (fail-closed — /openapi.json and /docs return 404). Set "true" here to keep
# the Scalar UI + spec available under `wrangler dev`.
OPENAPI_DOCS_ENABLED=true

# Optional: disable automatic __RequestVerificationToken injection on POST save-long-form (default on in wrangler.toml)
# CUSTOMER_SAVE_AUTO_TOKEN=false

# Optional: skip writing report CSVs to R2 (wrangler.toml / dashboard R2 binding)
# SNAPSHOTS_R2_ENABLED=false

# Optional: trust X-Forwarded-For for bearer-throttle bucketing (TOG-8888).
# Default in wrangler.toml is "false" (fail-closed — XFF-only callers share the
# "unknown" bucket). Set "true" here only for local dev behind no Cloudflare
# proxy; never enable on a deployed Worker.
# THROTTLE_TRUST_XFF=true

# Non-secret Worker defaults (wrangler.toml [vars]). `wrangler dev` overlays
# `.dev.vars` on those defaults, so these stay commented unless you need a
# local override. Every wrangler [vars] key must be mentioned here (active or
# commented) — enforced by `npm run check:vars-parity` (TOG-8367, gap G20).
# SESSION_TTL_SECONDS=1800
# TARGET_BASE_PATH=/WebRW
# LOGIN_URL=https://killeen.routeware.com/WebRW/Account/Login
# CUSTOMER_REPORT_EXPORT_PATH=
# CUSTOMER_REPORT_QUERY_ID=23
# ADDRESS_REPORT_EXPORT_PATH=
# ADDRESS_REPORT_QUERY_ID=24
# CONTAINER_REPORT_EXPORT_PATH=
# CONTAINER_REPORT_QUERY_ID=25
# REPORT_QUERY_START_DATE=1900-01-01
# REPORT_QUERY_END_DATE=1900-01-01
# SHADOW_API_PUBLIC_BASE=
# Base for problem+json `type` URIs (TOG-8357). Defaults to the committed docs
# URL when empty/unset; set it at transfer time to the new owner's repo, e.g.
# PROBLEM_TYPE_BASE=https://github.com/<new-owner>/routeware-shadow-api/blob/main/docs/PROBLEMS.md#
# PROBLEM_TYPE_BASE=
