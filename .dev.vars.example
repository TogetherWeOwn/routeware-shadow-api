# Copy to .dev.vars (gitignored). Never commit real values.
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Client auth for /api/v1/* (all routes except GET /api/v1/health).
# SHADOW_API_TOKEN falls back to CUSTOMER_SNAPSHOT_SYNC_SECRET when unset.
SHADOW_API_TOKEN=
CUSTOMER_SNAPSHOT_SYNC_SECRET=

# Optional: override for staging
# TARGET_ORIGIN=https://example.routeware.com

# Optional: disable interactive API docs (OpenAPI JSON still served at /openapi.json)
# OPENAPI_DOCS_ENABLED=false

# Optional: disable automatic __RequestVerificationToken injection on POST save-long-form (default on in wrangler.toml)
# CUSTOMER_SAVE_AUTO_TOKEN=false

# Optional: skip writing report CSVs to R2 (wrangler.toml / dashboard R2 binding)
# SNAPSHOTS_R2_ENABLED=false
