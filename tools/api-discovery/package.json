{
  "name": "routeware-api-discovery",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "playwright install chromium",
    "record": "tsx record.ts",
    "record:full": "tsx record.ts --full",
    "codegen": "node codegen.mjs",
    "aggregate": "node aggregate.mjs",
    "export:curls": "node export-curl-examples.mjs",
    "validate:harvest": "node validate-harvest.mjs",
    "docs:harvest": "node generate-harvest-docs.mjs",
    "gap:routes": "node route-gap.mjs",
    "gap:check": "node route-gap.mjs --check",
    "suggest:routes": "node suggest-routes.mjs",
    "process": "node validate-harvest.mjs && node aggregate.mjs && node generate-harvest-docs.mjs && (node route-gap.mjs || true) && node export-curl-examples.mjs && node suggest-routes.mjs && node route-gap.mjs --check"
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "tsx": "^4.19.2"
  }
}
