{
  "name": "routeware-shadow-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "npm run check:devvars",
    "dev": "wrangler dev",
    "check:devvars": "node scripts/check-devvars.mjs",
    "check:shadow-api-v1": "node scripts/check-shadow-api-v1.mjs",
    "check:ci-workflow": "node scripts/check-ci-workflow.mjs",
    "check:coverage-ratchet": "node scripts/check-coverage-ratchet.mjs",
    "check:r2-preflight": "node scripts/check-r2-preflight.mjs",
    "probe:post-deploy": "node scripts/post-deploy-probe.mjs",
    "dev:remote": "wrangler dev --remote",
    "db:migrate:local": "wrangler d1 migrations apply routeware-customer-snapshot --local",
    "db:migrate:remote": "wrangler d1 migrations apply routeware-customer-snapshot --remote",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:contracts": "vitest run test/shadowContract.test.ts test/shadowNegativePath.test.ts",
    "discovery:setup": "npm --prefix tools/api-discovery install && npm run setup --prefix tools/api-discovery",
    "discovery:process": "npm run process --prefix tools/api-discovery",
    "discovery:record": "npm run record --prefix tools/api-discovery",
    "discovery:record:full": "npm run record:full --prefix tools/api-discovery",
    "discovery:codegen": "npm run codegen --prefix tools/api-discovery",
    "discovery:verify": "npm run discovery:process && npm test",
    "secret:login-username": "wrangler secret put LOGIN_USERNAME",
    "secret:login-password": "wrangler secret put LOGIN_PASSWORD"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.4",
    "@hono/zod-openapi": "^1.3.0",
    "@scalar/hono-api-reference": "^0.9.48",
    "hono": "^4.12.14",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.14.9",
    "@vitest/coverage-istanbul": "^4.1.10",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.54.0"
  }
}
