{
  "name": "routeware-shadow-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "first-run": "node scripts/first-run.mjs",
    "help": "node scripts/help.mjs",
    "predev": "npm run check:devvars",
    "dev": "wrangler dev",
    "check:devvars": "node scripts/check-devvars.mjs",
    "check:shadow-api-v1": "node scripts/check-shadow-api-v1.mjs",
    "check:source-file-size": "node scripts/check-source-file-size.mjs",
    "check:d1-drift": "node scripts/check-d1-drift.mjs",
    "check:openapi-drift": "node scripts/check-openapi-drift.mjs",
    "check:openapi-agent-metadata": "vitest run test/openapiAgentMetadata.test.ts",
    "check:ci-workflow": "node scripts/check-ci-workflow.mjs",
    "check:coverage-ratchet": "node scripts/check-coverage-ratchet.mjs",
    "check:per-file-coverage": "node scripts/check-per-file-coverage.mjs",
    "check:r2-preflight": "node scripts/check-r2-preflight.mjs",
    "check:r2-manifest": "vitest run test/r2ManifestIdentity.acceptance.test.ts test/r2ManifestVerify.test.ts && node --test scripts/verify-r2-manifest.acceptance.test.mjs",
    "check:r2-lifecycle-proposal": "node scripts/check-r2-lifecycle-proposal.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:deps-audit": "node scripts/check-deps-audit.mjs",
    "check:docs-links": "node scripts/check-docs-links.mjs",
    "check:vars-parity": "node scripts/check-vars-parity.mjs",
    "verify:config": "node scripts/verify-config.mjs",
    "verify:config:json": "node scripts/verify-config.mjs --json",
    "verify:config:dry-run": "node scripts/verify-config.mjs --dry-run --json",
    "probe:post-deploy": "node scripts/post-deploy-probe.mjs",
    "probe:post-deploy:scheduled": "node scripts/post-deploy-probe.mjs --scheduled --skip-if-no-token",
    "smoke:readiness": "node scripts/smoke-readiness.mjs",
    "verify:r2-manifest": "node scripts/verify-r2-manifest.mjs",
    "dev:remote": "wrangler dev --remote",
    "db:migrate:local": "wrangler d1 migrations apply routeware-customer-snapshot --local",
    "db:migrate:remote": "wrangler d1 migrations apply routeware-customer-snapshot --remote",
    "db:seed": "node scripts/db-seed.mjs",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "pretypecheck": "npm run types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.src.json",
    "lint": "node scripts/check-console-usage.mjs",
    "test": "npm run test:probe && npm run test:console-usage && vitest run",
    "test:snapshot-export-memory": "node --expose-gc ./node_modules/vitest/vitest.mjs run --config vitest.memory.config.ts",
    "test:watch": "vitest",
    "test:coverage": "npm run test:probe && vitest run --coverage",
    "test:contracts": "vitest run test/shadowContract.test.ts test/shadowNegativePath.test.ts",
    "discovery:setup": "npm --prefix tools/api-discovery install && npm run setup --prefix tools/api-discovery",
    "discovery:process": "npm run process --prefix tools/api-discovery",
    "discovery:record": "npm run record --prefix tools/api-discovery",
    "discovery:record:full": "npm run record:full --prefix tools/api-discovery",
    "discovery:codegen": "npm run codegen --prefix tools/api-discovery",
    "discovery:verify": "npm run discovery:process && npm test",
    "secret:login-username": "wrangler secret put LOGIN_USERNAME",
    "secret:login-password": "wrangler secret put LOGIN_PASSWORD",
    "test:probe": "node --test scripts/verify-r2-manifest.acceptance.test.mjs scripts/post-deploy-probe.test.mjs scripts/check-r2-deploy-config.test.mjs scripts/check-r2-lifecycle-proposal.test.mjs scripts/smoke-readiness.test.mjs scripts/check-docs-links.test.mjs scripts/check-source-file-size.test.mjs scripts/wrapper-help.test.mjs scripts/verify-config-json.test.mjs scripts/verify-config-npm.test.mjs tools/api-discovery/curl-safety.acceptance.test.mjs tools/api-discovery/curl-argv-hardening.test.mjs tools/api-discovery/downstream-scripts.test.mjs tools/api-discovery/downstream-escapes.test.mjs",
    "test:discovery": "node --test tools/api-discovery/route-gap.test.mjs tools/api-discovery/route-gap-pipeline.test.mjs tools/api-discovery/validate-harvest.test.mjs",
    "test:console-usage": "node --test scripts/check-console-usage.test.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.4",
    "@hono/zod-openapi": "^1.3.0",
    "@scalar/hono-api-reference": "^0.9.48",
    "hono": "^4.13.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.14.9",
    "@vitest/coverage-istanbul": "^4.1.10",
    "entities": "^8.1.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.54.0",
    "marked": "18.1.0"
  }
}
