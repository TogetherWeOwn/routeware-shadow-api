{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily R2 manifest verification result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "checkId", "ok", "date", "mode", "dryRun", "coverage", "checks", "findings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "checkId": { "const": "r2-manifest" },
    "ok": { "type": "boolean" },
    "date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
    "mode": { "enum": ["local", "remote"] },
    "dryRun": { "type": "boolean" },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expectedTables", "verifiedTables"],
      "properties": {
        "kind": { "enum": ["listed-only", "expected-tables"] },
        "expectedTables": { "$ref": "#/$defs/tables" },
        "verifiedTables": { "$ref": "#/$defs/tables" }
      }
    },
    "checks": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/checkId" },
          "status": { "enum": ["pass", "fail"] }
        }
      }
    },
    "findings": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "code", "message", "retryable", "next_action"],
        "properties": {
          "id": { "$ref": "#/$defs/findingId" },
          "code": { "enum": ["R2_ARGUMENT_INVALID", "R2_REMOTE_CREDENTIAL_REQUIRED", "R2_OBJECT_MISSING", "R2_MANIFEST_INVALID", "R2_EXPECTED_TABLE_MISSING", "R2_HASH_MISMATCH"] },
          "message": { "type": "string", "minLength": 1, "maxLength": 256 },
          "retryable": { "const": false },
          "next_action": { "type": "string", "minLength": 1, "maxLength": 256 },
          "table": { "$ref": "#/$defs/table" }
        }
      }
    }
  },
  "$defs": {
    "table": { "enum": ["address", "container", "customer"] },
    "tables": { "type": "array", "maxItems": 3, "uniqueItems": true, "items": { "$ref": "#/$defs/table" } },
    "checkId": { "enum": ["r2-manifest.arguments", "r2-manifest.plan", "r2-manifest.credentials", "r2-manifest.manifest", "r2-manifest.coverage", "r2-manifest.object.address", "r2-manifest.object.container", "r2-manifest.object.customer"] },
    "findingId": { "enum": ["r2-manifest.arguments", "r2-manifest.credentials", "r2-manifest.manifest-read", "r2-manifest.manifest-schema", "r2-manifest.expected.address", "r2-manifest.expected.container", "r2-manifest.expected.customer", "r2-manifest.object.address", "r2-manifest.object.container", "r2-manifest.object.customer"] }
  }
}
