{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run check:devvars)",
      "Bash(npm ci)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run *)",
      "Bash(npx wrangler deploy --dry-run *)",
      "Bash(npm run db:migrate:local)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Bash(npm run deploy)",
      "Bash(npm run deploy *)",
      "Bash(wrangler deploy)",
      "Bash(wrangler deploy *)",
      "Bash(npx wrangler deploy)",
      "Bash(npm run db:migrate:remote)",
      "Bash(npm run db:migrate:remote *)",
      "Bash(wrangler secret *)",
      "Bash(npx wrangler secret *)",
      "Bash(npm run secret:login-username)",
      "Bash(npm run secret:login-password)",
      "Bash(npm publish)",
      "Read(./.dev.vars)"
    ]
  }
}
